@{ ViewData["Title"] = "Weather & Fire Conditions"; }
<h1>Farm weather & fire conditions</h1>
<p class="text-muted">Forecast for the Koes area using approximate town coordinates. Update the location to your farm's exact coordinates for a more precise forecast.</p>
<div class="d-flex flex-wrap gap-2 mb-3"><button class="btn btn-primary" onclick="loadForecast()">Refresh forecast</button><span id="status" class="small text-muted align-self-center">Loading…</span></div>
<div class="row g-3 mb-4" id="current"></div>
<section class="card p-4 mb-4"><h2>🌧️ 7-day rainfall & weather</h2><p class="small text-muted">Rain totals, probability, temperatures and wind. Forecast, not measured farm rainfall.</p><div class="table-responsive"><table class="table table-sm" id="forecast"><thead><tr><th>Date</th><th>Min / Max °C</th><th>Rain mm</th><th>Rain chance</th><th>Max wind km/h</th></tr></thead><tbody></tbody></table></div><h3>Rainfall forecast (mm)</h3><canvas id="rainChart" height="130" style="width:100%"></canvas></section>
<section class="card p-4 mb-4"><h2>🔥 Fire conditions</h2><div id="fireSummary" class="alert alert-secondary">Calculating weather-based fire conditions…</div><p class="small text-muted">This is a simple weather-based caution indicator—not an official fire danger rating and not a satellite-detected fire alert. Confirm fires with local authorities and check official alerts.</p><p><a href="https://firms.modaps.eosdis.nasa.gov/map/" target="_blank" rel="noopener">Open NASA FIRMS active-fire map</a> · <a href="https://www.meteoblue.com/" target="_blank" rel="noopener">Weather maps</a></p></section>
@section Scripts {
<script>
async function loadForecast(){
 const status=document.getElementById('status'); status.textContent='Fetching Koes-area forecast…';
 try {
  const res=await fetch('/Conditions/Forecast'); const data=await res.json(); if(!res.ok) throw new Error(data.error||'Forecast unavailable');
  const c=data.current;
  document.getElementById('current').innerHTML=[['Temperature',c.temp+' °C'],['Humidity',c.humidity+'%'],['Wind',c.windKmh+' km/h'],['Current rain',c.rainMm+' mm']].map(x=>`<div class="col-6 col-lg-3"><div class="card p-3 h-100"><div class="text-muted small">${x[0]}</div><div class="fs-4 fw-bold">${x[1]}</div></div></div>`).join('');
  document.querySelector('#forecast tbody').innerHTML=data.days.map(d=>`<tr><td>${d.date}</td><td>${d.minTemp.toFixed(1)} / ${d.maxTemp.toFixed(1)}</td><td>${d.rainMm.toFixed(1)}</td><td>${d.rainChance}%</td><td>${d.windKmh.toFixed(1)}</td></tr>`).join('');
  drawRain(data.days); showFire(data.current,data.days); status.textContent='Updated '+new Date(data.fetchedAt).toLocaleString()+' · Source: Open-Meteo';
 }catch(e){status.textContent='Could not load forecast: '+e.message;}
}
function drawRain(days){
 const canvas=document.getElementById('rainChart'),ctx=canvas.getContext('2d'); const w=canvas.clientWidth||700,h=220,dpr=window.devicePixelRatio||1; canvas.width=w*dpr;canvas.height=h*dpr;ctx.scale(dpr,dpr);ctx.clearRect(0,0,w,h);
 const max=Math.max(5,...days.map(d=>d.rainMm)),left=38,bottom=35,top=12,plotH=h-top-bottom,plotW=w-left-12;ctx.font='12px sans-serif';ctx.strokeStyle='#cbd5e1';ctx.fillStyle='#64748b';
 for(let n=0;n<=4;n++){const val=max*n/4,y=top+plotH-(plotH*n/4);ctx.beginPath();ctx.moveTo(left,y);ctx.lineTo(w-10,y);ctx.stroke();ctx.fillText(val.toFixed(1),2,y+4);}
 const slot=plotW/days.length,bw=Math.min(36,slot*.55);days.forEach((d,i)=>{const bh=d.rainMm/max*(plotH-4),x=left+i*slot+(slot-bw)/2,y=top+plotH-bh;ctx.fillStyle='#3995d6';ctx.fillRect(x,y,bw,bh);ctx.fillStyle='#475569';ctx.fillText(d.date.slice(5),x-4,h-12);});
}
function showFire(c,days){
 const rain=days.slice(0,3).reduce((s,d)=>s+d.rainMm,0),dry=rain<1,hot=c.temp>=32,windy=c.windKmh>=25;let label='Lower weather-based caution',cls='alert-success';
 if(hot&&dry){label='Elevated weather-based caution — hot and dry conditions';cls='alert-warning';}
 if(hot&&windy&&dry){label='High weather-based caution — hot, dry and windy conditions';cls='alert-danger';}
 document.getElementById('fireSummary').className='alert '+cls;document.getElementById('fireSummary').textContent=label+'. Next 3-day forecast rainfall: '+rain.toFixed(1)+' mm.';
}
document.addEventListener('DOMContentLoaded',loadForecast);
</script>
}
