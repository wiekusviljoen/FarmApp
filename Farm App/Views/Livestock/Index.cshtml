@model IEnumerable<Farm_App.Models.Livestock>
@{ ViewData["Title"] = "Livestock"; }
<div class="livestock-page-header d-flex justify-content-between align-items-center mb-4"><div><h1>Livestock register</h1><p class="text-muted">Track animal IDs, species, breed, camp, and status.</p></div><a class="btn btn-primary livestock-add-button" asp-action="Create">+ Add animal</a></div>
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }
<div class="nav nav-pills gap-2 mb-3 flex-nowrap overflow-auto" role="tablist" aria-label="Farm registers"><button type="button" class="nav-link active" role="tab" aria-selected="true" aria-controls="livestockTabPanel" onclick="showLivestockTab('livestockTabPanel',this)">🐑 Livestock register</button><button type="button" class="nav-link" role="tab" aria-selected="false" aria-controls="rainTabPanel" onclick="showLivestockTab('rainTabPanel',this)">🌧️ Rain register</button><button type="button" class="nav-link" role="tab" aria-selected="false" aria-controls="feedTabPanel" onclick="showLivestockTab('feedTabPanel',this)">🌾 Feed calculator</button></div>
<section id="livestockTabPanel" class="livestock-tab-panel">
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search tag, species, or camp" /></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button> <a class="btn btn-outline-secondary" asp-action="Index">Clear</a></div></form>
<div class="table-responsive livestock-table-wrap"><table class="table table-striped align-middle livestock-table"><thead><tr><th>Tag / ID</th><th>Species</th><th>Breed</th><th>Sex</th><th>Camp</th><th>Status</th><th>History</th><th></th></tr></thead><tbody>
@foreach (var a in Model) { <tr><td><strong>@a.TagNumber</strong></td><td>@a.Species</td><td>@a.Breed</td><td>@a.Sex</td><td>@a.Camp</td><td>@a.Status</td><td><a asp-action="History" asp-route-id="@a.Id" class="btn btn-sm btn-outline-success">Profile</a></td><td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No animal records yet. Add your first animal to get started.</td></tr> }
</tbody></table></div>
</section>
<section id="rainTabPanel" class="livestock-tab-panel d-none">
<section class="card p-4 mt-4" id="rainfallRegister">
 <div class="d-flex flex-wrap justify-content-between align-items-start gap-2"><div><h2>🌧️ Rain register & local rainfall</h2><p class="text-muted mb-2">Record measured rain by date and camp, and compare it with local weather data.</p></div><button type="button" class="btn btn-outline-primary" onclick="loadRainfallWeather()">Refresh online rain</button></div>
 <div class="alert alert-light border" id="rainfallWeatherSummary" aria-live="polite">Loading local rainfall data…</div>
 <div class="border rounded-3 p-3 mb-3" id="rainfallTrendPanel">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h3 class="h5 mb-1">Rainfall trend</h3><small class="text-muted" id="rainTrendDates">Historical daily rainfall</small></div><div class="d-flex flex-column gap-2"><span class="form-label mb-0">History period</span><div id="rainHistoryChoices" class="d-flex flex-wrap gap-2" role="group" aria-label="Rainfall history period"><button type="button" class="btn btn-sm btn-outline-primary" data-period="1m" onclick="selectRainHistoryPeriod(this)">1 month</button><button type="button" class="btn btn-sm btn-outline-primary" data-period="3m" onclick="selectRainHistoryPeriod(this)">3 months</button><button type="button" class="btn btn-sm btn-outline-primary" data-period="6m" onclick="selectRainHistoryPeriod(this)">6 months</button><button type="button" class="btn btn-sm btn-primary active" data-period="1y" aria-pressed="true" onclick="selectRainHistoryPeriod(this)">1 year</button><button type="button" class="btn btn-sm btn-outline-primary" data-period="2y" onclick="selectRainHistoryPeriod(this)">2 years</button><button type="button" class="btn btn-sm btn-outline-primary" data-period="5y" onclick="selectRainHistoryPeriod(this)">5 years</button></div></div></div>
  <div id="rainfallTrendStatus" class="small text-muted mb-2" aria-live="polite">Loading historical rainfall…</div>
  <div class="w-100" style="min-height:220px;overflow:hidden"><svg id="rainfallTrendChart" viewBox="0 0 760 270" role="img" aria-label="Historical rainfall trend chart" style="display:block;width:100%;height:auto;min-height:220px"></svg></div>
  <div class="small text-muted mt-2" id="rainfallTrendLegend">Online historical rainfall in millimetres</div>
 </div>
 <form asp-action="LogRainfall" method="post" class="row g-2 mb-3">
  @Html.AntiForgeryToken()
  <div class="col-6 col-md-3"><label class="form-label" for="rainDate">Date</label><input class="form-control" id="rainDate" name="date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
  <div class="col-6 col-md-3"><label class="form-label" for="rainCamp">Camp / gauge</label><input class="form-control" id="rainCamp" name="camp" maxlength="60" placeholder="e.g. Camp 1" /></div>
  <div class="col-6 col-md-3"><label class="form-label" for="rainMm">Rainfall (mm)</label><input class="form-control" id="rainMm" name="millimeters" type="number" min="0" max="2000" step="0.1" required placeholder="0.0" /></div>
  <div class="col-6 col-md-3"><label class="form-label" for="rainNotes">Notes</label><input class="form-control" id="rainNotes" name="notes" maxlength="500" placeholder="Optional" /></div>
  <div class="col-12"><button class="btn btn-primary" type="submit">Save rainfall entry</button></div>
 </form>
 @if (TempData["RainError"] is string rainError) { <div class="alert alert-danger">@rainError</div> }
 <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Date</th><th>Camp / gauge</th><th>Rain (mm)</th><th>Notes</th><th></th></tr></thead><tbody>
 @foreach (var rain in (IEnumerable<Farm_App.Models.RainfallRecord>)ViewBag.RainfallEntries) { <tr><td>@rain.Date.ToString("yyyy-MM-dd")</td><td>@(string.IsNullOrWhiteSpace(rain.Camp) ? "Farm gauge" : rain.Camp)</td><td>@rain.Millimeters.ToString("0.0")</td><td>@rain.Notes</td><td><form asp-action="DeleteRainfall" method="post" onsubmit="return confirm('Delete this rainfall entry?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@rain.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></td></tr> }
 @if (!((IEnumerable<Farm_App.Models.RainfallRecord>)ViewBag.RainfallEntries).Any()) { <tr><td colspan="5" class="text-center text-muted">No manual rainfall entries yet.</td></tr> }
 </tbody></table></div>
</section>
</section>
<section id="feedTabPanel" class="livestock-tab-panel d-none">
<section class="card p-4 mt-4"><h2>Animal feed & cost calculator</h2><p class="text-muted">Feed products, bag prices, mix costs, and feeding estimates.</p><div class="row g-4"><div class="col-12"><div class="card p-4 h-100">
  <h2>Animal feed cost calculator</h2>
  <p>Choose a Feedmaster product, keep its bag price up to date, and calculate mix costs.</p>
  <div class="mb-3"><div class="d-flex justify-content-between align-items-center gap-2"><label class="form-label" for="feedName">Feed product</label><button type="button" class="btn btn-sm btn-outline-secondary" onclick="refreshFeedProducts()">Refresh products</button></div><select id="feedName" class="form-select"><option value="">Loading product list...</option></select><small class="text-muted d-block mt-1" id="feedCatalogStatus">Feedmaster product catalog</small></div>
  <div class="row g-2 mb-3"><div class="col-sm-7"><label class="form-label">Current bag price (NAD)</label><input id="bagPrice" type="number" min="0" step="0.01" class="form-control" placeholder="Enter current supplier price" /></div><div class="col-sm-5"><label class="form-label">Bag size (kg)</label><input id="bagKg" type="number" min="1" step="1" class="form-control" value="50" /></div></div>
  <p class="small text-muted" id="feedPriceStatus">Enter the current supplier price; it will be saved for this product on this device.</p>
  <div class="mb-3"><label class="form-label">Amount used (kg)</label><input id="amountKg" type="number" min="0" step="0.1" class="form-control" placeholder="Kg in your mix" /></div>
  <p class="small fw-bold" id="ingredientPreview">Enter bag price and kg to preview ingredient cost.</p>
  <button class="btn btn-primary" onclick="addIngredient()">Add ingredient</button>
  <div class="table-responsive mt-4"><table class="table" id="ingredients"><thead><tr><th>Ingredient</th><th>Kg</th><th>Cost (NAD)</th></tr></thead><tbody></tbody></table></div>
  <p class="fw-bold" id="mixTotals">Mix total: NAD 0.00  |  Cost per kg: NAD 0.00</p>
  <button class="btn btn-outline-secondary" onclick="clearMix()">Clear mix</button>
  <hr class="my-4" />
  <h3>Feeding duration estimator</h3>
  <p>Estimate feed required and total cost for a selected product over a feeding period.</p>
  <div class="row g-3">
   <div class="col-6"><label class="form-label" for="animalCount">Number of active animals</label><input id="animalCount" type="number" min="0" step="1" value="@ViewBag.ActiveCount" class="form-control" readonly /><small class="text-muted">Automatically counted from active livestock records.</small></div>
   <div class="col-12"><div id="speciesCountSummary" class="small text-muted"></div></div>
   <div class="col-12"><h4 class="h6">Daily supplement by species</h4><div id="feedRationsBySpecies" class="table-responsive"><p class="text-muted small">Loading species rations…</p></div><small class="text-muted">Set the supplement amount in kg per head per day for each species. These are your ration settings, not total grazing intake.</small></div>
   <div class="col-12"><label class="form-label" for="seasonFactor">Rainfall-based supplement factor</label><div class="input-group"><input id="seasonFactor" type="number" min="0" max="2" step="0.05" value="1" class="form-control" /><span class="input-group-text">×</span></div><small class="text-muted" id="seasonFactorNote">Adjust after checking actual grazing and animal condition. Rainfall alone cannot determine feed needs.</small></div>
   <div class="col-8"><label class="form-label" for="durationValue">Feeding duration</label><input id="durationValue" type="number" min="1" step="1" value="30" class="form-control" /></div>
   <div class="col-4"><label class="form-label" for="durationUnit">Unit</label><select id="durationUnit" class="form-select"><option value="1">Days</option><option value="7">Weeks</option><option value="30">Months (30 days)</option></select></div>
  </div>
  <div class="alert alert-light border mt-3 mb-0"><div id="feedingEstimate" class="fw-bold">Choose a product and enter its price to estimate feed cost.</div><small class="text-muted">Planning estimate only. Rations are entered separately by species. Rainfall is only a rough signal—check actual veld condition, animal body condition and feed-label guidance before feeding.</small></div>
 </div></div></div></div></section>
</section>
@section Scripts {
<script>
function showLivestockTab(panelId, button) {
 document.querySelectorAll('.livestock-tab-panel').forEach(panel => panel.classList.toggle('d-none', panel.id !== panelId));
 document.querySelectorAll('[aria-controls="livestockTabPanel"], [aria-controls="rainTabPanel"], [aria-controls="feedTabPanel"]').forEach(tab => { const active = tab === button; tab.classList.toggle('active', active); tab.setAttribute('aria-selected', String(active)); });
}
const money = n => 'NAD ' + Number(n).toFixed(2);
function escapeHtml(s) { return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
const manualRain30 = @ViewBag.ManualRain30.ToString(System.Globalization.CultureInfo.InvariantCulture);
const livestockCounts = @Html.Raw(ViewBag.SpeciesCountsJson);
function renderSpeciesCountSummary() {
 const el=document.getElementById('speciesCountSummary');
 el.textContent=livestockCounts.length ? 'Registered active stock: '+livestockCounts.map(x=>`${x.species}: ${x.count}`).join(' · ') : 'No active livestock is registered.';
}
const rationStoreKey='farmflow.dailyRations.v1';
function renderRationTable() {
 const target=document.getElementById('feedRationsBySpecies');
 let saved={}; try { saved=JSON.parse(localStorage.getItem(rationStoreKey)||'{}'); } catch {}
 if(!livestockCounts.length){target.innerHTML='<p class="text-muted">No active livestock to calculate.</p>';return;}
 target.innerHTML='<table class="table table-sm align-middle"><thead><tr><th>Species</th><th>Heads</th><th>Supplement kg/head/day</th></tr></thead><tbody>'+livestockCounts.map(x=>`<tr><td>${escapeHtml(x.species)}</td><td>${x.count}</td><td><input type="number" min="0" max="100" step="0.05" class="form-control form-control-sm feed-ration-input" data-species="${escapeHtml(x.species)}" value="${saved[x.species]??0}" aria-label="Daily supplement for ${escapeHtml(x.species)}" /></td></tr>`).join('')+'</tbody></table>';
 target.querySelectorAll('.feed-ration-input').forEach(input=>input.addEventListener('input',()=>{const next={};target.querySelectorAll('.feed-ration-input').forEach(x=>next[x.dataset.species]=Number(x.value)||0);localStorage.setItem(rationStoreKey,JSON.stringify(next));updateFeedingEstimate();}));
}
let rainCoords = null;
const rainRegionCoordinates = {
 'Koes': { latitude: -25.95, longitude: 18.05 },
 'Karas': { latitude: -26.6, longitude: 18.1 },
 'Hardap': { latitude: -24.5, longitude: 17.9 },
 'Khomas': { latitude: -22.6, longitude: 17.1 },
 'Erongo': { latitude: -22.0, longitude: 14.5 },
 'Kunene': { latitude: -19.4, longitude: 13.0 },
 'Oshana': { latitude: -17.8, longitude: 15.7 },
 'Omusati': { latitude: -18.4, longitude: 14.9 },
 'Ohangwena': { latitude: -17.6, longitude: 16.0 },
 'Oshikoto': { latitude: -18.3, longitude: 17.1 },
 'Kavango East': { latitude: -18.0, longitude: 19.7 },
 'Kavango West': { latitude: -18.1, longitude: 18.0 },
 'Zambezi': { latitude: -17.8, longitude: 24.2 },
 'Otjozondjupa': { latitude: -20.5, longitude: 17.5 }
};
function currentRainLocation() {
 const mode = localStorage.getItem('farmLocationMode') || 'auto';
 const region = localStorage.getItem('farmRegion') || 'Koes';
 if (mode === 'manual') return { ... (rainRegionCoordinates[region] || rainRegionCoordinates.Koes), label: region + ' (approximate region centre)' };
 return rainCoords ? { ...rainCoords, label: 'GPS location' } : { ...rainRegionCoordinates.Koes, label: 'Koes area (approximate fallback)' };
}
function drawRainfallTrend(records, period) {
 const svg=document.getElementById('rainfallTrendChart');
 while(svg.firstChild) svg.removeChild(svg.firstChild);
 const ns='http://www.w3.org/2000/svg';
 const make=(tag,attrs,text)=>{const el=document.createElementNS(ns,tag);Object.entries(attrs||{}).forEach(([k,v])=>el.setAttribute(k,v));if(text!==undefined)el.textContent=text;return el;};
 let points=records.map(r=>({date:r.date,value:Number(r.rainMm)||0}));
 if(['6m','1y','2y','5y'].includes(period)){
  const buckets={};points.forEach(p=>{const key=p.date.slice(0,7);buckets[key]=(buckets[key]||0)+p.value;});
  points=Object.entries(buckets).map(([date,value])=>({date,value}));
 }
 if(!points.length){svg.appendChild(make('text',{x:380,y:130,'text-anchor':'middle',fill:'currentColor'},'No rainfall data available'));return;}
 const W=760,H=270,L=52,R=16,T=14,B=42,plotW=W-L-R,plotH=H-T-B;
 const max=Math.max(10,...points.map(p=>p.value));
 for(let i=0;i<=4;i++){const y=T+plotH-(i/4)*plotH;svg.appendChild(make('line',{x1:L,y1:y,x2:W-R,y2:y,stroke:'currentColor','stroke-opacity':'.15'}));svg.appendChild(make('text',{x:L-8,y:y+4,'text-anchor':'end','font-size':11,fill:'currentColor'},(max*i/4).toFixed(0)));}
 const step=plotW/points.length, barW=Math.max(1,Math.min(24,step*.68));
 points.forEach((p,i)=>{const x=L+i*step+(step-barW)/2;const h=Math.max(1,p.value/max*plotH);const rect=make('rect',{x,y:T+plotH-h,width:barW,height:h,rx:Math.min(3,barW/3),fill:'#269b83'});rect.appendChild(make('title',{},`${p.date}: ${p.value.toFixed(1)} mm`));svg.appendChild(rect);});
 const labels=[0,Math.floor((points.length-1)/2),points.length-1];[...new Set(labels)].forEach(i=>{const p=points[i],label=period==='1m'?p.date.slice(5):p.date;svg.appendChild(make('text',{x:L+i*step+step/2,y:H-14,'text-anchor':'middle','font-size':11,fill:'currentColor'},label));});
}
let rainHistoryPeriod = '1y';
function selectRainHistoryPeriod(button) {
 rainHistoryPeriod = button.dataset.period;
 document.querySelectorAll('#rainHistoryChoices button').forEach(item => {
  const active = item === button;
  item.classList.toggle('btn-primary', active);
  item.classList.toggle('active', active);
  item.classList.toggle('btn-outline-primary', !active);
  item.setAttribute('aria-pressed', String(active));
 });
 loadRainfallTrend();
}
async function loadRainfallTrend() {
 const period=rainHistoryPeriod; 
 const status=document.getElementById('rainfallTrendStatus');
 status.textContent='Loading historical rainfall…';
 try {
  const location=currentRainLocation();
  const query=new URLSearchParams({period,latitude:location.latitude,longitude:location.longitude});
  const response=await fetch('/Livestock/RainfallHistory?'+query.toString());
  const data=await response.json();if(!response.ok)throw new Error(data.error||'Historical data unavailable');
  drawRainfallTrend(data.records,period);
  document.getElementById('rainTrendDates').textContent=`${data.startDate} to ${data.endDate} · ${location.label}`;
  const total=data.records.reduce((sum,r)=>sum+(Number(r.rainMm)||0),0);
  status.textContent=`${data.records.length} daily observations · Total: ${total.toFixed(1)} mm · Source: ${data.source}`;
 } catch(error){status.textContent='Could not load rainfall history: '+error.message;}
}
async function loadRainfallWeather() {
 const summary=document.getElementById('rainfallWeatherSummary');
 summary.textContent='Getting local rainfall history and forecast…';
 const fetchAt=async coords=>{
  if(coords) rainCoords=coords;
  const location=currentRainLocation();
  const query='?'+new URLSearchParams({latitude:location.latitude,longitude:location.longitude});
  const response=await fetch('/Livestock/RainfallWeather'+query); const data=await response.json();
  if(!response.ok) throw new Error(data.error||'Rainfall data unavailable');
  const next7=data.days.filter(d=>d.isForecast).reduce((sum,d)=>sum+d.rainMm,0);
  const past=data.past30DaysMm;
  const signal=past<10?'Low recent rainfall (dry signal)':past<30?'Some recent rainfall (mixed signal)':'Higher recent rainfall (wetter signal)';
  const factor=past<10?1:(past<30?.75:.5);
  document.getElementById('seasonFactor').value=factor;
  document.getElementById('seasonFactorNote').textContent=`${signal}. Suggested planning factor ${factor.toFixed(2)}× based on a simple rainfall threshold, not measured grazing. Adjust for veld condition, animal stage and advice.`;
  updateFeedingEstimate();
  summary.innerHTML=`<strong>${signal}</strong><br>Recent 30-day rainfall (online): <strong>${past.toFixed(1)} mm</strong> · Next 7-day forecast: <strong>${next7.toFixed(1)} mm</strong><br>Manual rain register (last 30 days): <strong>${Number(manualRain30).toFixed(1)} mm</strong><br><small>Location: ${escapeHtml(location.label)} · Source: ${escapeHtml(data.source)} · Updated ${new Date(data.fetchedAt).toLocaleString()}</small>`;
 };
 if((localStorage.getItem('farmLocationMode')||'auto')==='manual'){rainCoords=null;fetchAt(null).then(loadRainfallTrend).catch(e=>{summary.textContent='Online rainfall unavailable: '+e.message;loadRainfallTrend();});}
 else if(navigator.geolocation){navigator.geolocation.getCurrentPosition(pos=>fetchAt({latitude:pos.coords.latitude,longitude:pos.coords.longitude}).then(loadRainfallTrend).catch(e=>{summary.textContent='Online rainfall unavailable: '+e.message;loadRainfallTrend();}),()=>fetchAt(null).then(loadRainfallTrend).catch(e=>{summary.textContent='Online rainfall unavailable: '+e.message;loadRainfallTrend();}),{timeout:12000,maximumAge:300000});}
 else {fetchAt(null).then(loadRainfallTrend).catch(e=>{summary.textContent='Online rainfall unavailable: '+e.message;loadRainfallTrend();});}
}
const feedProducts = [
 {name:'Feedlot 80',group:'Beef cattle',bagKg:50},{name:'Bush Improver Lick',group:'Beef cattle / sheep',bagKg:50},
 {name:'Cattle Lick 40',group:'Beef cattle',bagKg:50},{name:'Eco-Grassveld Lick',group:'General livestock',bagKg:50},
 {name:'Cattle Mix 4:1:5',group:'Beef cattle',bagKg:50},{name:'Beefpro 14 Pellets',group:'Beef cattle',bagKg:50},
 {name:'Rangeland Grower Meal',group:'Cattle / sheep / goats',bagKg:50},{name:'Feed Concentrate HPC 30',group:'Cattle / sheep / goats',bagKg:50},
 {name:'Breker 12',group:'Cattle / sheep / goats',bagKg:50},{name:'Enerfeed',group:'Cattle / sheep / goats',bagKg:50},
 {name:'Enermol',group:'Cattle / sheep / goats',bagKg:50},{name:'Yellow Maize Meal No.1',group:'Cattle / sheep / goats',bagKg:50},
 {name:'Yellow Maize Meal No.2',group:'Cattle / sheep / goats',bagKg:50},{name:'Lucerne Pellets',group:'Cattle / sheep / game',bagKg:50},
 {name:'Dry Veld Concentrate',group:'Cattle / sheep / goats',bagKg:50},{name:'Complete Sheep Finisher',group:'Sheep',bagKg:50},
 {name:'Ram-Lam-Ewe Pellets',group:'Sheep',bagKg:50},{name:'Production Lick',group:'Sheep / goats',bagKg:40},
 {name:'Super Lambing Lick',group:'Sheep / goats',bagKg:50},{name:'Creep Feed',group:'Sheep / goats',bagKg:50},
 {name:'Stud Feed',group:'Sheep / goats',bagKg:50},{name:'Game Lick',group:'Game',bagKg:50},
 {name:'Standard Game Pellets',group:'Game',bagKg:50},{name:'Stud Game Pellets',group:'Game',bagKg:50},
 {name:'Game Block',group:'Game / horses',bagKg:20},{name:'Futterfos P6',group:'Minerals',bagKg:50},
 {name:'Futterfos Block',group:'Minerals',bagKg:20},{name:'Futterfos',group:'Minerals',bagKg:40},
 {name:'Veefos P12',group:'Minerals',bagKg:50},{name:'Dryveld Block',group:'Minerals',bagKg:20},
 {name:'Energy Block',group:'Minerals',bagKg:20},{name:'Cow Calf Lick',group:'Beef cattle',bagKg:50},
 {name:'Calf Starter',group:'Dairy / calves',bagKg:50},{name:'Calf Grower',group:'Dairy / calves',bagKg:50},
 {name:'Layer Mash',group:'Poultry',bagKg:50},{name:'Broiler Starter',group:'Poultry',bagKg:50},
 {name:'Broiler Grower',group:'Poultry',bagKg:50},{name:'Enerfeed (pig feed)',group:'Pigs',bagKg:50},
 {name:'Enermol (pig feed)',group:'Pigs',bagKg:50}
];
const feedPriceStoreKey = 'farmflow.feedPrices.v1';
function readFeedPrices() { try { return JSON.parse(localStorage.getItem(feedPriceStoreKey) || '{}'); } catch { return {}; } }
let feedPrices = readFeedPrices();
function selectedProduct() { return feedProducts.find(p => p.name === document.getElementById('feedName').value); }
function renderFeedProductOptions(keepName = '') {
 const select = document.getElementById('feedName');
 const groups = [...new Set(feedProducts.map(p => p.group))];
 select.innerHTML = '<option value="">Choose a feed product...</option>' + groups.map(group =>
  '<optgroup label="' + escapeHtml(group) + '">' + feedProducts.filter(p => p.group === group).map(p =>
   '<option value="' + escapeHtml(p.name) + '">' + escapeHtml(p.name) + ' (' + p.bagKg + ' kg)</option>').join('') + '</optgroup>').join('');
 if (keepName && feedProducts.some(p => p.name === keepName)) select.value = keepName;
}
function initFeedProducts() {
 const select = document.getElementById('feedName');
 select.addEventListener('change', loadSelectedProduct);
 renderFeedProductOptions();
 loadSelectedProduct();
}
async function refreshFeedProducts() {
 const status = document.getElementById('feedCatalogStatus');
 const keepName = document.getElementById('feedName').value;
 status.textContent = 'Refreshing product catalog from Feedmaster...';
 try {
  const response = await fetch('/Market/FeedProducts');
  const data = await response.json();
  if (!response.ok) throw new Error(data.error || 'Catalog unavailable');
  const refreshed = data.products.map(p => {
   const group = p.group || 'Feedmaster products';
   return {name:p.name, group, bagKg:Number(p.bagKg)||50};
  });
  if (!refreshed.length) throw new Error('No products were returned.');
  feedProducts.splice(0, feedProducts.length, ...refreshed);
  renderFeedProductOptions(keepName);
  loadSelectedProduct();
  status.textContent = 'Catalog refreshed ' + new Date(data.fetchedAt).toLocaleString() + '  |  ' + refreshed.length + ' products.';
 } catch (error) {
  status.textContent = 'Could not refresh catalog: ' + error.message + '  |  Showing available saved choices.';
 }
}
function loadSelectedProduct() {
 const product = selectedProduct();
 const priceInput = document.getElementById('bagPrice');
 const saved = product && feedPrices[product.name];
 document.getElementById('bagKg').value = saved ? saved.bagKg : (product ? product.bagKg : 50);
 priceInput.value = saved ? saved.price : '';
 document.getElementById('feedPriceStatus').textContent = saved
  ? 'Saved price: ' + money(saved.price) + ' per ' + saved.bagKg + ' kg bag  |  Updated ' + new Date(saved.updatedAt).toLocaleString() + ' (stored on this device).'
  : 'No saved price for this product. Enter the latest supplier price; it will be saved on this device.';
 updatePreviews();
}
function saveSelectedFeedPrice() {
 const product = selectedProduct(), value = Number(document.getElementById('bagPrice').value);
 const bagKg = Number(document.getElementById('bagKg').value);
 if (!product || document.getElementById('bagPrice').value === '' || !Number.isFinite(value) || value <= 0 || !Number.isFinite(bagKg) || bagKg <= 0) return;
 feedPrices[product.name] = {price:value, updatedAt:new Date().toISOString(), bagKg};
 localStorage.setItem(feedPriceStoreKey, JSON.stringify(feedPrices));
 document.getElementById('feedPriceStatus').textContent = 'Price saved: ' + money(value) + ' per ' + bagKg + ' kg bag  |  Updated just now (this device only).';
 updatePreviews();
}
const ingredients = [];
function addIngredient() {
 const product = selectedProduct();
 const name = product ? product.name : '';
 const price = Number(document.getElementById('bagPrice').value);
 const bagKg = Number(document.getElementById('bagKg').value) || 50;
 const kg = Number(document.getElementById('amountKg').value);
 if (!name || price <= 0 || !Number.isFinite(price) || kg <= 0) { alert('Choose a product and enter its current bag price and kg used.'); return; }
 ingredients.push({name, kg, cost: price / bagKg * kg}); renderMix();
}
function renderMix() {
 const total = ingredients.reduce((s,x) => s+x.cost,0), kg = ingredients.reduce((s,x) => s+x.kg,0);
 document.querySelector('#ingredients tbody').innerHTML = ingredients.map(x => `<tr><td>${escapeHtml(x.name)}</td><td>${x.kg.toFixed(1)}</td><td>${money(x.cost)}</td></tr>`).join('');
 document.getElementById('mixTotals').textContent = `Mix total: ${money(total)}  |  Total weight: ${kg.toFixed(1)} kg  |  Cost per kg: ${money(kg ? total/kg : 0)}`;
}
function clearMix() { ingredients.length=0; renderMix(); }
function updateFeedingEstimate() {
 const product=selectedProduct(), price=Number(document.getElementById('bagPrice').value), bagKg=Number(document.getElementById('bagKg').value)||50;
 const factor=Number(document.getElementById('seasonFactor').value);
 const days=Number(document.getElementById('durationValue').value)*Number(document.getElementById('durationUnit').value);
 const rationInputs=[...document.querySelectorAll('.feed-ration-input')];
 const count=livestockCounts.reduce((sum,x)=>sum+x.count,0);
 const dailyBaseKg=rationInputs.reduce((sum,input)=>sum+(livestockCounts.find(x=>x.species===input.dataset.species)?.count||0)*(Number(input.value)||0),0);
 const target=document.getElementById('feedingEstimate');
 if(!product || price<=0 || count<=0 || !Number.isFinite(factor) || factor<0 || days<=0){target.textContent='Choose a product, enter its current bag price, and complete the feeding details.';return;}
 const dailyKg=dailyBaseKg*factor, totalKg=dailyKg*days, bags=Math.ceil(totalKg/bagKg), totalCost=totalKg/bagKg*price, bagCost=bags*price;
 target.textContent=`${count} active animals · ${days.toLocaleString()} days · ${dailyKg.toLocaleString(undefined,{maximumFractionDigits:1})} kg/day · ${totalKg.toLocaleString(undefined,{maximumFractionDigits:1})} kg total · ${bags.toLocaleString()} bags of ${bagKg} kg · Estimated cost: ${money(totalCost)} (full bags: ${money(bagCost)})`;
}
function updatePreviews() {
 const bag = Number(document.getElementById('bagPrice').value) || 0;
 const bagKg = Number(document.getElementById('bagKg').value) || 50;
 const kg = Number(document.getElementById('amountKg').value) || 0;
 document.getElementById('ingredientPreview').textContent = bag > 0 && kg > 0 ? `Ingredient estimate: ${money(bag / bagKg * kg)} for ${kg.toFixed(1)} kg  |  ${money(bag / bagKg)} per kg` : 'Enter bag price and kg to preview ingredient cost.';
 updateFeedingEstimate();
}
['bagPrice','amountKg','seasonFactor','durationValue','durationUnit','bagKg'].forEach(id => document.getElementById(id).addEventListener('input', updatePreviews));
document.getElementById('bagPrice').addEventListener('change', saveSelectedFeedPrice);
document.getElementById('bagKg').addEventListener('change', saveSelectedFeedPrice);
document.getElementById('durationUnit').addEventListener('change', updatePreviews);
window.addEventListener('farm-location-changed',()=>{rainCoords=null;loadRainfallWeather();});
document.addEventListener('DOMContentLoaded', () => { renderSpeciesCountSummary(); renderRationTable(); initFeedProducts(); updatePreviews(); refreshFeedProducts(); loadRainfallWeather(); });
</script>
}