@model IEnumerable<Farm_App.Models.Livestock>
@{ ViewData["Title"] = "Livestock"; }
<div class="livestock-page-header d-flex justify-content-between align-items-center mb-4"><div><h1>Livestock register</h1><p class="text-muted">Track animal IDs, species, breed, camp, and status.</p></div><a class="btn btn-primary livestock-add-button" asp-action="Create">+ Add animal</a></div>
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search tag, species, or camp" /></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button> <a class="btn btn-outline-secondary" asp-action="Index">Clear</a></div></form>
<div class="table-responsive livestock-table-wrap"><table class="table table-striped align-middle livestock-table"><thead><tr><th>Tag / ID</th><th>Species</th><th>Breed</th><th>Sex</th><th>Camp</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var a in Model) { <tr><td><strong>@a.TagNumber</strong></td><td>@a.Species</td><td>@a.Breed</td><td>@a.Sex</td><td>@a.Camp</td><td>@a.Status</td><td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No animal records yet. Add your first animal to get started.</td></tr> }
</tbody></table></div>