@model IEnumerable<Farm_App.Models.Livestock>
@{ ViewData["Title"] = "Livestock"; }
<style>
.livestock-register-tabs .farm-tab-button{appearance:none;border:1px solid #d7dee7;background:#fff;color:#344054;border-radius:10px;padding:.55rem 1rem;font-weight:600;line-height:1.2;cursor:pointer;transition:all .15s ease}
.livestock-register-tabs .farm-tab-button:hover{background:#f3f6f9;border-color:#98a2b3}
.livestock-register-tabs .farm-tab-button.active{background:#198754;border-color:#198754;color:#fff;box-shadow:0 2px 6px rgba(25,135,84,.2)}
@@media(max-width:576px){.livestock-register-tabs{display:grid!important;grid-template-columns:1fr}.livestock-register-tabs .farm-tab-button{width:100%;text-align:center}}
</style>

<div class="livestock-page-header d-flex justify-content-between align-items-center mb-4"><div><h1>Livestock register</h1><p class="text-muted">Track animal IDs, species, breed, camp, and status.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-success" asp-controller="Camps" asp-action="Index">Manage camps</a><a class="btn btn-primary livestock-add-button" asp-action="Create">+ Add animal</a></div></div>
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }
<div class="livestock-register-tabs d-flex flex-wrap gap-2 mb-3" role="tablist" aria-label="Farm registers"><button type="button" class="farm-tab-button active" role="tab" aria-selected="true" aria-controls="livestockTabPanel" onclick="showLivestockTab('livestockTabPanel',this)">Livestock register</button><button type="button" class="farm-tab-button" role="tab" aria-selected="false" aria-controls="rainTabPanel" onclick="showLivestockTab('rainTabPanel',this)">Rain register</button><button type="button" class="farm-tab-button" role="tab" aria-selected="false" aria-controls="feedTabPanel" onclick="showLivestockTab('feedTabPanel',this)">Feed calculator</button></div>
<section id="livestockTabPanel" class="livestock-tab-panel">
<form method="get" class="row g-2 mb-3"><div class="col-sm-8"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search tag, species, or camp" /></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button> <a class="btn btn-outline-secondary" asp-action="Index">Clear</a></div></form>
<div class="table-responsive livestock-table-wrap"><table class="table table-striped align-middle livestock-table"><thead><tr><th>Tag / ID</th><th>Species</th><th>Breed</th><th>Sex</th><th>Camp</th><th>Status</th><th>History</th><th></th></tr></thead><tbody>
@foreach (var a in Model) { <tr><td><strong>@a.TagNumber</strong></td><td>@a.Species</td><td>@a.Breed</td><td>@a.Sex</td><td>@a.Camp</td><td>@a.Status</td><td><a asp-action="History" asp-route-id="@a.Id" class="btn btn-sm btn-outline-success">Profile</a></td><td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Update profile</a> <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No animal records yet. Add your first animal to get started.</td></tr> }
</tbody></table></div>
</section>
<section id="rainTabPanel" class="livestock-tab-panel d-none">
<section class="card p-4 mt-4" id="rainfallRegister">
 <div class="d-flex flex-wrap justify-content-between align-items-start gap-2"><div><h2>Rain register & local rainfall</h2><p class="text-muted mb-2">Record measured rain by date and camp, and compare it with local weather data.</p></div><button type="button" class="btn btn-outline-primary" onclick="loadRainfallWeather()">Refresh online rain</button></div>
 <div class="alert alert-light border" id="rainfallWeatherSummary" aria-live="polite">Loading local rainfall data...</div>
 <div class="border rounded-3 p-3 mb-3" id="rainfallTrendPanel">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h3 class="h5 mb-1">Rainfall trend</h3><small class="text-muted" id="rainTrendDates">Historical daily rainfall</small></div><div class="d-flex flex-column gap-2"><span class="form-label mb-0">History period</span><div id="rainHistoryChoices" class="d-flex flex-wrap gap-2" role="group" aria-label="Farm Rain Register period"><button type="button" class="btn btn-sm btn-outline-primary" data-period="1m" onclick="selectRainHistoryPeriod(this)">1 month</button><button type="button" class="btn btn-sm btn-outline-primary" data-period="3m" onclick="selectRainHistoryPeriod(this)">3 months</button><button type="button" class="btn btn-sm btn-outline-primary" data-period="6m" onclick="selectRainHistoryPeriod(this)">6 months</button><button type="button" class="btn btn-sm btn-primary active" data-period="1y" aria-pressed="true" onclick="selectRainHistoryPeriod(this)">1 year</button><button type="button" class="btn btn-sm btn-outline-primary" data-period="2y" onclick="selectRainHistoryPeriod(this)">2 years</button><button type="button" class="btn btn-sm btn-outline-primary" data-period="5y" onclick="selectRainHistoryPeriod(this)">5 years</button><button type="button" class="btn btn-sm btn-outline-success" data-period="season" onclick="selectRainHistoryPeriod(this)">Rain season (Oct-Jul)</button></div></div></div>
  <div class="row g-2 mb-3 align-items-end"><div class="col-12 col-md-5"><label class="form-label mb-1" for="rainCity">Rain location</label><select id="rainCity" class="form-select" onchange="selectRainCity(this.value)"><option value="Koes">Koes</option><option value="Bethanie">Bethanie</option><option value="Helmeringhausen">Helmeringhausen</option><option value="Keetmanshoop">Keetmanshoop</option><option value="Luderitz">Luderitz</option><option value="Windhoek">Windhoek</option><option value="Mariental">Mariental</option><option value="Rehoboth">Rehoboth</option><option value="Gobabis">Gobabis</option><option value="Otjiwarongo">Otjiwarongo</option><option value="Swakopmund">Swakopmund</option><option value="Walvis Bay">Walvis Bay</option><option value="Oshakati">Oshakati</option><option value="Rundu">Rundu</option><option value="Katima Mulilo">Katima Mulilo</option><option value="Opuwo">Opuwo</option><option value="Outjo">Outjo</option><option value="Tsumeb">Tsumeb</option><option value="Grootfontein">Grootfontein</option><option value="Otavi">Otavi</option></select><small class="text-muted">Choose a town/city to view its historical rainfall.</small></div></div>
  <div id="rainfallTrendStatus" class="small text-muted mb-2" aria-live="polite">Loading historical rainfall...</div>
  <div class="w-100" style="min-height:220px;overflow:hidden"><svg id="rainfallTrendChart" viewBox="0 0 760 270" role="img" aria-label="Historical rainfall trend chart" style="display:block;width:100%;height:auto;min-height:220px"></svg></div>
  <div class="small text-muted mt-2" id="rainfallTrendLegend">Online historical rainfall in millimetres</div>
 </div>
 <form asp-action="LogRainfall" method="post" class="row g-2 mb-3">
  @Html.AntiForgeryToken()
  <div class="col-6 col-md-3"><label class="form-label" for="rainDate">Date</label><input class="form-control" id="rainDate" name="date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
  <div class="col-6 col-md-3"><label class="form-label" for="rainCamp">Camp / gauge</label><input class="form-control" id="rainCamp" name="camp" maxlength="60" placeholder="e.g. Camp 1" /></div>
  <div class="col-6 col-md-3"><label class="form-label" for="rainMm">Rainfall (mm)</label><input class="form-control" id="rainMm" name="millimeters" type="number" min="0" max="2000" step="0.1" required placeholder="0.0" /></div>
  <div class="col-6 col-md-3"><label class="form-label" for="rainNotes">Notes</label><input class="form-control" id="rainNotes" name="notes" maxlength="500" placeholder="Optional" /></div>
  <div class="col-12"><button class="btn btn-primary" type="submit">Save rainfall entry</button></div>
 </form>
 @if (TempData["RainError"] is string rainError) { <div class="alert alert-danger">@rainError</div> }
 <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Date</th><th>Camp / gauge</th><th>Rain (mm)</th><th>Notes</th><th></th></tr></thead><tbody>
 @foreach (var rain in (IEnumerable<Farm_App.Models.RainfallRecord>)ViewBag.RainfallEntries) { <tr><td>@rain.Date.ToString("yyyy-MM-dd")</td><td>@(string.IsNullOrWhiteSpace(rain.Camp) ? "Farm gauge" : rain.Camp)</td><td>@rain.Millimeters.ToString("0.0")</td><td>@rain.Notes</td><td><form asp-action="DeleteRainfall" method="post" onsubmit="return confirm('Delete this rainfall entry?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@rain.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></td></tr> }
 @if (!((IEnumerable<Farm_App.Models.RainfallRecord>)ViewBag.RainfallEntries).Any()) { <tr><td colspan="5" class="text-center text-muted">No manual rainfall entries yet.</td></tr> }
 </tbody></table></div>
</section>
</section>
<section id="feedTabPanel" class="livestock-tab-panel d-none">
<section class="card p-4 mt-4 feed-budget-card">
  <h2>Feed cost planner</h2>
  <p class="text-muted">Choose the animals, enter their average body mass, and estimate feed quantities and costs for the period you plan to feed them.</p>
  <div class="row g-3 mb-4">
    <div class="col-12 col-md-5"><label class="form-label" for="feedName">Feed product</label><select id="feedName" class="form-select"><option value="">Loading feed products...</option></select><small id="feedCatalogStatus" class="text-muted d-block mt-1">Choose the feed you plan to use.</small></div>
    <div class="col-12 col-md-3"><label class="form-label" for="feedBasis">Feed amount basis</label><select id="feedBasis" class="form-select"><option value="complete" selected>Complete feed (% body mass)</option><option value="supplement">Lick / supplement (kg per head)</option></select><small id="feedBasisHelp" class="text-muted d-block mt-1">Complete-feed percentages are estimates. Follow the product label.</small></div>
    <div class="col-7 col-md-2"><label class="form-label" for="bagPrice">Bag price (NAD)</label><input id="bagPrice" type="number" min="0" step="0.01" class="form-control" placeholder="Price" /><small class="text-muted d-block mt-1">Feedmaster does not publish live retail bag prices online. Enter your supplier price or <a href="https://www.feedmaster.com.na/contact-us" target="_blank" rel="noopener">ask Feedmaster</a>.</small></div>
    <div class="col-5 col-md-2"><label class="form-label" for="bagKg">Bag size (kg)</label><input id="bagKg" type="number" min="1" step="1" value="50" class="form-control" /></div>
  </div>
  <div class="mb-3"><button type="button" id="findFeedPrice" class="btn btn-outline-primary">Find current price online</button><div id="feedPriceSearchResult" class="alert alert-light border mt-2 mb-0 d-none" role="status" aria-live="polite"></div></div>
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2"><h3 class="h5 mb-0">Animals to feed</h3><button type="button" class="btn btn-outline-success" id="addFeedAnimal">+ Add animal type</button></div>
  <p class="small text-muted">Add each animal type separately. For complete feeds, body-mass percentages are only planning estimates. For licks and concentrates, use the product-label rate and mixing directions.</p>
  <div id="feedAnimalRows" class="d-grid gap-3"></div>
  <div class="row g-3 mt-2">
    <div class="col-6 col-md-4"><label class="form-label" for="planDuration">Feeding duration</label><input id="planDuration" type="number" min="1" step="1" value="30" class="form-control" /></div>
    <div class="col-6 col-md-3"><label class="form-label" for="planDurationUnit">Unit</label><select id="planDurationUnit" class="form-select"><option value="1">Days</option><option value="7">Weeks</option><option value="30">Months</option></select></div>
    <div class="col-6 col-md-3"><label class="form-label" for="feedingDaysPerWeek">Feeding days per week</label><select id="feedingDaysPerWeek" class="form-select"><option value="1">1 day</option><option value="2">2 days</option><option value="3">3 days</option><option value="4">4 days</option><option value="5">5 days</option><option value="6">6 days</option><option value="7" selected>Every day (7)</option></select></div>
  </div>
  <div class="mt-3">
    <label class="form-label" for="feedAdviceContext">Extra details for feed advice (optional)</label>
    <textarea id="feedAdviceContext" class="form-control" rows="2" placeholder="e.g. dry veld, pregnant ewes, lamb growth, maintenance, drought supplementation"></textarea>
    <button type="button" id="getFeedAdvice" class="btn btn-outline-success mt-2">Get feed recommendation</button>
    <div id="feedAdviceResult" class="alert alert-light border mt-3 mb-0 d-none" role="status" aria-live="polite"></div>
    @Html.AntiForgeryToken()
  </div>
  <div class="card bg-light border-0 p-3 mt-4">
    <h3 class="h5">Estimated feeding cost</h3>
    <div class="row g-3">
      <div class="col-6 col-lg-3"><small class="text-muted d-block">Feed per day</small><strong id="feedTotalDaily">—</strong></div>
      <div class="col-6 col-lg-3"><small class="text-muted d-block">Feed for full period</small><strong id="feedTotalPeriod">—</strong></div>
      <div class="col-6 col-lg-3"><small class="text-muted d-block">Estimated cost</small><strong id="feedTotalCost" class="text-success">—</strong></div>
      <div class="col-6 col-lg-3"><small class="text-muted d-block">Whole bags to buy</small><strong id="feedTotalBags">—</strong></div>
    </div>
    <div class="table-responsive mt-3"><table class="table table-sm align-middle mb-0"><thead><tr><th>Animal type</th><th>Daily feed</th><th>Period feed</th><th>Period cost</th></tr></thead><tbody id="feedCostBreakdown"></tbody></table></div>
    <small class="text-muted mt-3">Cost is prorated by kilograms used. “Whole bags” rounds up to the next bag, so the purchase cost may be higher than the feed consumed estimate. This is a planning estimate, not a veterinary ration prescription.</small>
  </div>
  <details class="mt-3"><summary class="small text-muted">Saved product price details</summary><p id="feedPriceStatus" class="small text-muted mt-2 mb-0">Enter a price to save it on this device.</p><button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="refreshFeedProducts()">Refresh feed products</button></details>
  <div hidden>
    <input id="amountKg" value="0" /><p id="ingredientPreview"></p><table id="ingredients"><tbody></tbody></table><p id="mixTotals"></p><input id="animalCount" value="0" /><div id="speciesCountSummary"></div><div id="feedRationsBySpecies"></div><input id="seasonFactor" value="1" /><p id="seasonFactorNote"></p><input id="durationValue" value="30" /><select id="durationUnit"><option value="1">Days</option></select><div id="feedingEstimate"></div>
  </div>
</section>
</section>
@section Scripts {
<script>
function showLivestockTab(panelId, button) {
 document.querySelectorAll('.livestock-tab-panel').forEach(panel => panel.classList.toggle('d-none', panel.id !== panelId));
 document.querySelectorAll('[aria-controls="livestockTabPanel"], [aria-controls="rainTabPanel"], [aria-controls="feedTabPanel"]').forEach(tab => { const active = tab === button; tab.classList.toggle('active', active); tab.setAttribute('aria-selected', String(active)); });
}
const money = n => 'NAD ' + Number(n).toFixed(2);
function escapeHtml(s) { return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
const manualRain30 = @ViewBag.ManualRain30.ToString(System.Globalization.CultureInfo.InvariantCulture);
const livestockCounts = @Html.Raw(ViewBag.SpeciesCountsJson);
function renderSpeciesCountSummary() {
 const el=document.getElementById('speciesCountSummary');
 el.textContent=livestockCounts.length ? 'Registered active stock: '+livestockCounts.map(x=>`${x.species}: ${x.count}`).join(' &middot; ') : 'No active livestock is registered.';
}
const rationStoreKey='farmflow.dailyRations.v1';
function renderRationTable() {
 const target=document.getElementById('feedRationsBySpecies');
 let saved={}; try { saved=JSON.parse(localStorage.getItem(rationStoreKey)||'{}'); } catch {}
 if(!livestockCounts.length){target.innerHTML='<p class="text-muted">No active livestock to calculate.</p>';return;}
 target.innerHTML='<table class="table table-sm align-middle"><thead><tr><th>Species</th><th>Heads</th><th>Supplement kg/head/day</th></tr></thead><tbody>'+livestockCounts.map(x=>`<tr><td>${escapeHtml(x.species)}</td><td>${x.count}</td><td><input type="number" min="0" max="100" step="0.05" class="form-control form-control-sm feed-ration-input" data-species="${escapeHtml(x.species)}" value="${saved[x.species]??0}" aria-label="Daily supplement for ${escapeHtml(x.species)}" /></td></tr>`).join('')+'</tbody></table>';
 target.querySelectorAll('.feed-ration-input').forEach(input=>input.addEventListener('input',()=>{const next={};target.querySelectorAll('.feed-ration-input').forEach(x=>next[x.dataset.species]=Number(x.value)||0);localStorage.setItem(rationStoreKey,JSON.stringify(next));updateFeedingEstimate();}));
}
let rainCoords = null;
const rainRegionCoordinates = {
 'Koes': { latitude: -25.95, longitude: 18.05 },
 'Karas': { latitude: -26.6, longitude: 18.1 },
 'Hardap': { latitude: -24.5, longitude: 17.9 },
 'Khomas': { latitude: -22.6, longitude: 17.1 },
 'Erongo': { latitude: -22.0, longitude: 14.5 },
 'Kunene': { latitude: -19.4, longitude: 13.0 },
 'Oshana': { latitude: -17.8, longitude: 15.7 },
 'Omusati': { latitude: -18.4, longitude: 14.9 },
 'Ohangwena': { latitude: -17.6, longitude: 16.0 },
 'Oshikoto': { latitude: -18.3, longitude: 17.1 },
 'Kavango East': { latitude: -18.0, longitude: 19.7 },
 'Kavango West': { latitude: -18.1, longitude: 18.0 },
 'Zambezi': { latitude: -17.8, longitude: 24.2 },
 'Otjozondjupa': { latitude: -20.5, longitude: 17.5 }
};
const rainCityCoordinates = { 'Koes':[-25.95,18.05], 'Bethanie':[-26.50,17.16], 'Helmeringhausen':[-25.89,16.82], 'Keetmanshoop':[-26.58,18.13], 'Luderitz':[-26.65,15.16], 'Mariental':[-24.63,17.97], 'Windhoek':[-22.56,17.08], 'Rehoboth':[-23.32,17.08], 'Gobabis':[-22.45,18.97], 'Otjiwarongo':[-20.46,16.65], 'Swakopmund':[-22.68,14.53], 'Walvis Bay':[-22.96,14.51], 'Oshakati':[-17.79,15.70], 'Rundu':[-17.93,19.77], 'Katima Mulilo':[-17.50,24.27], 'Opuwo':[-18.06,13.84], 'Outjo':[-20.11,16.15], 'Tsumeb':[-19.24,17.72], 'Grootfontein':[-19.57,18.12], 'Otavi':[-19.64,17.34] };
function selectRainCity(city) { localStorage.setItem('farmRainCity',city); rainCoords=null; loadRainfallWeather(); }
function currentRainLocation() {
 const city=localStorage.getItem('farmRainCity') || 'Koes';
 if(rainCityCoordinates[city]) return {latitude:rainCityCoordinates[city][0],longitude:rainCityCoordinates[city][1],label:city};
 const mode = localStorage.getItem('farmLocationMode') || 'auto';
 const region = localStorage.getItem('farmRegion') || 'Koes';
 if (mode === 'manual') return { ... (rainRegionCoordinates[region] || rainRegionCoordinates.Koes), label: region + ' (approximate region centre)' };
 return rainCoords ? { ...rainCoords, label: 'GPS location' } : { ...rainRegionCoordinates.Koes, label: 'Koes area (approximate fallback)' };
}
function drawRainfallTrend(records, period) {
 const svg=document.getElementById('rainfallTrendChart');
 while(svg.firstChild) svg.removeChild(svg.firstChild);
 const ns='http://www.w3.org/2000/svg';
 const make=(tag,attrs,text)=>{const el=document.createElementNS(ns,tag);Object.entries(attrs||{}).forEach(([k,v])=>el.setAttribute(k,v));if(text!==undefined)el.textContent=text;return el;};
 let points=records.map(r=>({date:r.date,value:Number(r.rainMm)||0}));
 if(['6m','1y','2y','5y','season'].includes(period)){
  const buckets={};points.forEach(p=>{const key=p.date.slice(0,7);buckets[key]=(buckets[key]||0)+p.value;});
  points=Object.entries(buckets).map(([date,value])=>({date,value}));
 }
 if(!points.length){svg.appendChild(make('text',{x:380,y:130,'text-anchor':'middle',fill:'currentColor'},'No rainfall data available'));return;}
 const W=760,H=270,L=52,R=16,T=14,B=42,plotW=W-L-R,plotH=H-T-B;
 const max=Math.max(10,...points.map(p=>p.value));
 for(let i=0;i<=4;i++){const y=T+plotH-(i/4)*plotH;svg.appendChild(make('line',{x1:L,y1:y,x2:W-R,y2:y,stroke:'currentColor','stroke-opacity':'.15'}));svg.appendChild(make('text',{x:L-8,y:y+4,'text-anchor':'end','font-size':11,fill:'currentColor'},(max*i/4).toFixed(0)));}
 const step=plotW/points.length, barW=Math.max(1,Math.min(24,step*.68));
 points.forEach((p,i)=>{const x=L+i*step+(step-barW)/2;const h=Math.max(1,p.value/max*plotH);const rect=make('rect',{x,y:T+plotH-h,width:barW,height:h,rx:Math.min(3,barW/3),fill:'#269b83'});rect.appendChild(make('title',{},`${p.date}: ${p.value.toFixed(1)} mm`));svg.appendChild(rect);});
 const labels=period==='season'
  ? points.map((_,i)=>i)
  : [0,Math.floor((points.length-1)/2),points.length-1];
 [...new Set(labels)].forEach(i=>{const p=points[i],label=period==='season'
   ? new Date(p.date+'-02').toLocaleDateString(undefined,{month:'short'})
   : period==='1m' ? new Date(p.date+'T00:00:00').toLocaleDateString(undefined,{day:'numeric',month:'short'}) : p.date;
  svg.appendChild(make('text',{x:L+i*step+step/2,y:H-14,'text-anchor':'middle','font-size':period==='season'?11:10,fill:'currentColor'},label));
 });
 if(period==='1m'){
  let lastLabelRight = -Infinity;
  points.forEach((p,i)=>{
   if(p.value<=0) return;
   const x=L+i*step+step/2;
   const h=Math.max(1,p.value/max*plotH);
   const label=p.value.toFixed(1)+' mm';
   const estimatedWidth=label.length*6.2;
   const left=x-estimatedWidth/2;
   const right=x+estimatedWidth/2;
   // Keep rainfall amounts readable: skip a label when it would collide with the previous one.
   // The bar tooltip still contains the exact date and amount for every day.
   if(left < lastLabelRight+4) return;
   svg.appendChild(make('text',{x,y:T+plotH-h-5,'text-anchor':'middle','font-size':10,'font-weight':'700',fill:'currentColor'},label));
   lastLabelRight=right;
  });
 }
}
let rainHistoryPeriod = '1y';
function selectRainHistoryPeriod(button) {
 rainHistoryPeriod = button.dataset.period;
 document.querySelectorAll('#rainHistoryChoices button').forEach(item => {
  const active = item === button;
  item.classList.toggle('btn-primary', active);
  item.classList.toggle('active', active);
  item.classList.toggle('btn-outline-primary', !active);
  item.setAttribute('aria-pressed', String(active));
 });
 loadRainfallTrend();
}
async function loadRainfallTrend() {
 const period=rainHistoryPeriod; 
 const status=document.getElementById('rainfallTrendStatus');
 status.textContent='Loading historical rainfallâ€¦';
 try {
  const location=currentRainLocation();
  const query=new URLSearchParams({period,latitude:location.latitude,longitude:location.longitude});
  const response=await fetch('/Livestock/RainfallHistory?'+query.toString());
  const data=await response.json();if(!response.ok)throw new Error(data.error||'Historical data unavailable');
  drawRainfallTrend(data.records,period);
  document.getElementById('rainTrendDates').textContent=data.season
    ? `Rain season ${data.season} &middot; October to July &middot; ${location.label}`
    : `${data.startDate} to ${data.endDate} &middot; ${location.label}`;
  const total=data.records.reduce((sum,r)=>sum+(Number(r.rainMm)||0),0);
  status.textContent=period==='season'
    ? `${data.records.length} daily observations grouped into monthly season totals &middot; Total: ${total.toFixed(1)} mm &middot; Source: ${data.source}`
    : `${data.records.length} daily observations &middot; Total: ${total.toFixed(1)} mm &middot; Source: ${data.source}`;
 } catch(error){status.textContent='Could not load farm rain register: '+error.message;}
}
