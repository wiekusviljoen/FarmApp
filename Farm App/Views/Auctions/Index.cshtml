@model List<Farm_App.Models.AuctionEvent>
@using System.Globalization
@{
    ViewData["Title"] = "Auction Calendar";
    var start = (DateTime)ViewBag.MonthStart;
    var previous = (DateTime)ViewBag.Previous;
    var next = (DateTime)ViewBag.Next;
    var days = DateTime.DaysInMonth(start.Year, start.Month);
    var offset = (int)start.DayOfWeek;
    var monthItems = Model.Where(x => x.Date.Year == start.Year && x.Date.Month == start.Month).ToList();
    var upcoming = Model.Where(x => x.Date.Date >= DateTime.Today).OrderBy(x => x.Date).ToList();
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="mb-1">Auction Calendar</h1><p class="text-muted mb-0">Upcoming auctions imported from published auctioneer calendars. Feed refreshes automatically every 6 hours.</p><small class="text-muted">@((int)(ViewBag.FeedCount ?? 0)) online events · Last checked: @(((DateTime?)ViewBag.FeedUpdated)?.ToString("dd MMM yyyy HH:mm") ?? "checking…")</small></div><a class="btn btn-outline-secondary" href="#add-auction">＋ Add personal event</a></div>
@if (ViewBag.FeedNotice != null) { <div class="alert alert-warning"><strong>Official auction notice:</strong> @ViewBag.FeedNotice <a href="https://www.whkla.com/auction-calendar/" target="_blank" rel="noopener">View source ↗</a></div> }
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-warning">@TempData["Error"]</div> }
<div class="card shadow-sm mb-4"><div class="card-body">
<div class="d-flex justify-content-between align-items-center mb-3"><a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-year="@previous.Year" asp-route-month="@previous.Month">‹ Previous</a><h2 class="h4 mb-0">@start.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</h2><a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-year="@next.Year" asp-route-month="@next.Month">Next ›</a></div>
<div class="table-responsive auction-calendar-wrap"><table class="table table-bordered text-center align-middle mb-0 auction-calendar"><thead><tr>@foreach (var day in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" }) { <th>@day</th> }</tr></thead><tbody>
@for (var week = 0; week < 6; week++) { <tr>@for (var dow = 0; dow < 7; dow++) { var n = week * 7 + dow - offset + 1;<td class="calendar-day">@if (n >= 1 && n <= days) { var date = new DateTime(start.Year, start.Month, n); var onDay = monthItems.Where(x => x.Date.Date == date.Date).ToList(); <div class="text-start"><span class="@(date.Date == DateTime.Today ? "badge bg-primary" : "calendar-date")">@n</span></div>@foreach (var a in onDay.Take(2)) { <div class="calendar-event-wrap"><a href="#auction-@a.Id" title="@a.Name" class="calendar-event">@a.Name@if (!string.IsNullOrWhiteSpace(a.Livestock)) { <span class="calendar-livestock"> · @a.Livestock</span> }</a></div> } @if (onDay.Count > 2) { <small class="calendar-more">+@(onDay.Count - 2) more</small> } }</td> }</tr> if ((week + 1) * 7 >= days + offset) { break; } }
</tbody></table></div>
@if (!monthItems.Any()) { <p class="text-muted mt-3 mb-0">No auctions saved for this month yet. Add one below.</p> }
</div></div>
<div class="row g-4"><div class="col-lg-7"><h2 class="h4 mb-3">Upcoming auctions <span class="badge bg-secondary">@upcoming.Count</span></h2>
@if (!upcoming.Any()) { <div class="alert alert-light border">No upcoming auctions saved. Add an auction or enter details from an auction notice.</div> }
@foreach (var a in upcoming) { <div class="card shadow-sm mb-3" id="auction-@a.Id"><div class="card-body"><div class="d-flex justify-content-between gap-3"><div><span class="badge @(a.IsImported ? "bg-primary" : "bg-secondary") mb-2">@a.Date.ToString("ddd, dd MMM yyyy")</span> @if (a.IsImported) { <span class="badge bg-info text-dark mb-2">Online feed</span> }<h3 class="h5">@a.Name</h3></div>@if (!a.IsImported) { <form asp-action="Delete" method="post" onsubmit="return confirm('Remove this personal event?');"><input type="hidden" name="id" value="@a.Id"/><button class="btn btn-sm btn-outline-danger" type="submit">Remove</button></form> }</div>
<div class="row small g-2">@if (!string.IsNullOrWhiteSpace(a.Time)) { <div class="col-sm-6"><strong>Time:</strong> @a.Time</div> } @if (!string.IsNullOrWhiteSpace(a.Organizer)) { <div class="col-sm-6"><strong>Organizer:</strong> @a.Organizer</div> } @if (!string.IsNullOrWhiteSpace(a.Venue)) { <div class="col-sm-6"><strong>Venue:</strong> @a.Venue</div> } @if (!string.IsNullOrWhiteSpace(a.ProvinceOrRegion)) { <div class="col-sm-6"><strong>Region:</strong> @a.ProvinceOrRegion</div> } @if (!string.IsNullOrWhiteSpace(a.AuctionType)) { <div class="col-sm-6"><strong>Sale type:</strong> @a.AuctionType</div> } @if (!string.IsNullOrWhiteSpace(a.Livestock)) { <div class="col-sm-6"><strong>Livestock:</strong> @a.Livestock</div> } @if (!string.IsNullOrWhiteSpace(a.Contact)) { <div class="col-sm-6"><strong>Contact:</strong> @a.Contact</div> }</div>
@if (!string.IsNullOrWhiteSpace(a.Details)) { <p class="mt-3 mb-2">@a.Details</p> } @if (!string.IsNullOrWhiteSpace(a.Website)) { <a href="@a.Website" target="_blank" rel="noopener">Auction notice / website ↗</a> }
</div></div> }
</div>
<div class="col-lg-5" id="add-auction"><div class="card shadow-sm"><div class="card-body"><h2 class="h4 mb-3">Add an auction</h2><p class="small text-muted">Online auctions are imported automatically. Use this form only for a personal event or a source not yet covered.</p>
<form asp-action="Create" method="post"><div class="mb-3"><label class="form-label" for="Name">Auction name *</label><input class="form-control" id="Name" name="Name" maxlength="140" required placeholder="e.g. Karas Small Stock Auction" /></div>
<div class="row g-3"><div class="col-sm-7"><label class="form-label" for="Date">Date *</label><input class="form-control" type="date" id="Date" name="Date" required value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div><div class="col-sm-5"><label class="form-label" for="Time">Time</label><input class="form-control" id="Time" name="Time" placeholder="09:00" /></div>
<div class="col-12"><label class="form-label" for="Organizer">Organizer / auctioneer</label><input class="form-control" id="Organizer" name="Organizer" /></div><div class="col-12"><label class="form-label" for="Venue">Venue / farm</label><input class="form-control" id="Venue" name="Venue" /></div><div class="col-12"><label class="form-label" for="ProvinceOrRegion">Town / region</label><input class="form-control" id="ProvinceOrRegion" name="ProvinceOrRegion" /></div>
<div class="col-sm-6"><label class="form-label" for="AuctionType">Auction type</label><select class="form-select" id="AuctionType" name="AuctionType"><option value="">Select…</option><option>Livestock</option><option>Stud / breeding</option><option>Commercial</option><option>Game</option><option>Equipment</option><option>Other</option></select></div><div class="col-sm-6"><label class="form-label" for="Livestock">Livestock</label><input class="form-control" id="Livestock" name="Livestock" placeholder="Sheep, cattle…" /></div>
<div class="col-12"><label class="form-label" for="Contact">Contact details</label><input class="form-control" id="Contact" name="Contact" /></div><div class="col-12"><label class="form-label" for="Website">Website / auction notice URL</label><input class="form-control" type="url" id="Website" name="Website" placeholder="https://…" /></div><div class="col-12"><label class="form-label" for="Details">Details / notes</label><textarea class="form-control" id="Details" name="Details" rows="4" placeholder="Lots, catalogue, registration info, terms…"></textarea></div></div><button class="btn btn-primary w-100 mt-3" type="submit">Save auction</button></form>
</div></div></div></div>
