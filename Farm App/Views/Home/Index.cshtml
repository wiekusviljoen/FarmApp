@{
    ViewData["Title"] = "Farm Dashboard";
}

<section class="dashboard-hero">
    <div class="hero-copy">
        <span class="dashboard-kicker">FARM MANAGEMENT · KOES</span>
        <h1>Your farm.<br /><span>One clear view.</span></h1>
        <p>Keep livestock records, check market prices, and plan around the weather—all in one place.</p>
        <div class="hero-actions">
            <a class="btn btn-light btn-lg" asp-controller="Livestock" asp-action="Index">Open livestock register <span aria-hidden="true">→</span></a>
            <a class="hero-text-link" asp-controller="Conditions" asp-action="Index">Check weather <span aria-hidden="true">↗</span></a>
        </div>
    </div>
    <div class="hero-emblem" aria-hidden="true"><span>🌾</span><small>BUILT FOR<br />THE FARM</small></div>
</section>

<section class="dashboard-section" aria-labelledby="tools-heading">
    <div class="section-heading"><div><span class="dashboard-kicker">YOUR WORKSPACE</span><h2 id="tools-heading">Farm tools</h2></div><span class="section-note">Choose where to go</span></div>
    <div class="dashboard-tools">
        <a class="dashboard-tool livestock-tool" asp-controller="Livestock" asp-action="Index">
            <div class="tool-top"><span class="tool-icon">🐑</span><span class="tool-arrow">↗</span></div>
            <h3>Livestock register</h3><p>Record animals, update details, and keep your herd information organized.</p><span class="tool-link">Manage livestock <span>→</span></span>
        </a>
        <a class="dashboard-tool market-tool" asp-controller="Market" asp-action="Index">
            <div class="tool-top"><span class="tool-icon">📈</span><span class="tool-arrow">↗</span></div>
            <h3>Market & calculators</h3><p>Explore published meat prices and calculate feed mixes and costs.</p><span class="tool-link">Open market tools <span>→</span></span>
        </a>
        <a class="dashboard-tool weather-tool" asp-controller="Conditions" asp-action="Index">
            <div class="tool-top"><span class="tool-icon">☀️</span><span class="tool-arrow">↗</span></div>
            <h3>Weather & fire</h3><p>See the 7-day forecast, rainfall outlook, and weather-based fire caution.</p><span class="tool-link">View conditions <span>→</span></span>
        </a>
    </div>
</section>

<section class="dashboard-note">
    <div class="note-icon">✦</div><div><h2>Practical information, all together</h2><p>Use the tools above to keep records current and make day-to-day farm decisions with the information available.</p></div>
</section>
