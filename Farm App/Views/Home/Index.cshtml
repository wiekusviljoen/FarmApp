@model Farm_App.Models.DashboardViewModel
@{
    ViewData["Title"] = "Farm Dashboard";
}

@if (User.Identity?.IsAuthenticated != true)
{
    <section class="guest-dashboard-banner" aria-label="Guest dashboard notice">
        <div><strong>Welcome to your Farm dashboard</strong><p>You're viewing the public dashboard preview. Sign in to see your own livestock, rainfall, and farm records.</p></div>
        <div class="guest-dashboard-actions"><a class="btn btn-success" asp-area="Identity" asp-page="/Account/Login">Log in</a><a class="btn btn-outline-success" asp-area="Identity" asp-page="/Account/Register">Create account</a></div>
    </section>
}

<section class="dashboard-hero">
    <div class="hero-copy">
        <span class="dashboard-kicker">FARM MANAGEMENT</span>
        <h1>Your farm.<br /><span>One clear view.</span></h1>
        <p>Keep livestock records, check market prices, and plan around the weather — all in one place.</p>
        <div class="hero-actions">
            <a class="btn btn-light btn-lg" asp-controller="Livestock" asp-action="Index">Open livestock register <span aria-hidden="true">&#8594;</span></a>
            <a class="hero-text-link" asp-controller="Conditions" asp-action="Index">Check weather <span aria-hidden="true">&#8599;</span></a>
        </div>
    </div>
    <div class="hero-emblem"><img src="/FarmIcon-512.png?v=20261001-exact" alt="Farm wind-pump logo" /></div>
</section>

@if (User.Identity?.IsAuthenticated == true && Context.Request.Query["passkeyPrompt"] == "1" && !Context.Request.Cookies.ContainsKey("farm.passkey.prompted"))
{
<div class="farm-passkey-modal-backdrop" id="farmPasskeyPrompt" role="presentation">
    <div class="farm-passkey-modal card shadow-lg border-0" role="dialog" aria-modal="true" aria-labelledby="farmPasskeyTitle">
        <div class="card-body p-4 text-center">
            <div class="farm-passkey-icon" aria-hidden="true">🔐</div>
            <h2 id="farmPasskeyTitle" class="h3 mb-2">Use fingerprint next time?</h2>
            <p class="text-muted mb-4">You're logged in. Set up fingerprint login on this device for faster sign-in. Your fingerprint stays on your phone.</p>
            <form id="farmPasskeyAntiForgery" method="post" style="display:none">@Html.AntiForgeryToken()</form>
            <button type="button" id="farmPasskeyRegister" class="btn btn-success btn-lg w-100">Set up fingerprint login</button>
            <a id="farmPasskeySkip" href="@Url.Action("Skip", "Passkey", new { returnUrl = "/" })" class="btn btn-link mt-2">Not now</a>
            <div id="farmPasskeyStatus" class="small mt-2" role="status" aria-live="polite"></div>
        </div>
    </div>
</div>
}

@if (User.Identity?.IsAuthenticated == true)
{
<section class="dashboard-section notification-promo" aria-labelledby="notifications-heading">
    <div class="notification-promo-inner">
        <div class="notification-promo-copy">
            <span class="dashboard-kicker">FARM ALERTS</span>
            <h2 id="notifications-heading">Get farm notifications on your phone.</h2>
            <p id="pushStatus">Enable notifications for reminders, livestock events and important farm alerts.</p>
            <form id="pushAntiforgeryForm" method="post" style="display:none">@Html.AntiForgeryToken()</form>
            <div class="hero-actions">
                <button type="button" id="enablePushButton" class="btn btn-success btn-lg">Enable notifications</button>
                <button type="button" id="testPushButton" class="btn btn-outline-success btn-lg" hidden>Send test notification</button>
            </div>
        </div>
    </div>
</section>
}

<section class="dashboard-section offline-mode-promo" aria-labelledby="offline-mode-heading">
    <div class="offline-mode-promo-inner">
        <div class="offline-mode-icon" aria-hidden="true">&#128246;</div>
        <div class="offline-mode-copy">
            <span class="dashboard-kicker">FARM OFFLINE MODE</span>
            <h2 id="offline-mode-heading">Keep working when the signal disappears.</h2>
            <p>Record important farm events even without internet. Births, deaths, treatments, movements, sales, purchases, new animals, rainfall and notes can be saved on your phone and synced automatically when you reconnect.</p>
            <div class="offline-mode-points">
                <span> Works without signal</span><span> Saves on your device</span><span> Syncs when online</span>
            </div>
        </div>
        <a class="btn btn-success btn-lg" href="/offline.html">Open Offline Mode </a>
    </div>
</section>

<section class="dashboard-section" aria-labelledby="farm-snapshot-heading">
    <div class="section-heading"><div><span class="dashboard-kicker">YOUR FARM AT A GLANCE</span><h2 id="farm-snapshot-heading">Farm snapshot</h2></div><span class="section-note">Your records only</span></div>
    <div class="dashboard-metrics">
        <article class="dashboard-metric"><span class="metric-icon">&#128017;</span><div><span class="metric-label">Active animals</span><strong>@Model.ActiveAnimals</strong><small>@Model.TotalAnimals total records</small></div></article>
        <article class="dashboard-metric"><span class="metric-icon">&#127783;</span><div><span class="metric-label">Rain this month</span><strong>@Model.RainfallThisMonth.ToString("0.0") <small>mm</small></strong><small>From your rain register</small></div></article>
        <article class="dashboard-metric"><span class="metric-icon">&#127868;</span><div><span class="metric-label">Births this month</span><strong>@Model.BirthsThisMonth</strong><small>Logged livestock events</small></div></article>
        <article class="dashboard-metric"><span class="metric-icon">&#128205;</span><div><span class="metric-label">Camps in use</span><strong>@Model.CampCount</strong><small>With active animals</small></div></article>
    </div>
    <div class="dashboard-metrics dashboard-metrics-secondary mt-3">
        <article class="dashboard-metric dashboard-metric-compact"><div><span class="metric-label">Deaths this month</span><strong>@Model.DeathsThisMonth</strong></div></article>
        <article class="dashboard-metric dashboard-metric-compact"><div><span class="metric-label">Species in register</span><strong>@Model.SpeciesCounts.Count</strong></div></article>
    </div>
</section>

<section class="dashboard-section" aria-labelledby="recent-activity-heading">
    <div class="section-heading"><div><span class="dashboard-kicker">LIVESTOCK RECORDS</span><h2 id="recent-activity-heading">Recent activity</h2></div><a class="btn btn-outline-primary" asp-controller="Livestock" asp-action="Index">Open register </a></div>
    <div class="card p-3 p-md-4">
        @if (Model.RecentEvents.Count == 0)
        {
            <p class="text-muted mb-0">No livestock events recorded yet. Open an animals history to log births, purchases, sales, deaths, movements, treatments, or vaccinations.</p>
        }
        else
        {
            <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Date</th><th>Animal</th><th>Event</th><th>Details</th><th></th></tr></thead><tbody>
            @foreach (var item in Model.RecentEvents)
            {
                <tr><td class="text-nowrap">@item.EventDate.ToString("dd MMM yyyy")</td><td><strong>@(item.Livestock?.TagNumber ?? "Animal")</strong><div class="small text-muted">@item.Livestock?.Species</div></td><td>@item.EventType</td><td>@(string.IsNullOrWhiteSpace(item.Notes) ? "" : item.Notes) @if (item.Amount.HasValue) { <span class="text-muted"> NAD @item.Amount.Value.ToString("N2")</span> }</td><td><a class="btn btn-sm btn-outline-primary" asp-controller="Livestock" asp-action="History" asp-route-id="@item.LivestockId">History</a></td></tr>
            }
            </tbody></table></div>
        }
    </div>
</section>

<section class="dashboard-section" aria-labelledby="tools-heading">
    <div class="section-heading"><div><span class="dashboard-kicker">YOUR WORKSPACE</span><h2 id="tools-heading">Farm tools</h2></div><span class="section-note">Choose where to go</span></div>
    <div class="dashboard-tools">
        <a class="dashboard-tool livestock-tool" asp-controller="Livestock" asp-action="Index">
            <div class="tool-top"><span class="tool-icon">&#128017;</span><span class="tool-arrow">&#8599;</span></div>
            <h3>Livestock register</h3><p>Record animals, update details, and keep your herd information organized.</p><span class="tool-link">Manage livestock <span>&#8594;</span></span>
        </a>
        <a class="dashboard-tool market-tool" asp-controller="Market" asp-action="Index">
            <div class="tool-top"><span class="tool-icon">&#128200;</span><span class="tool-arrow">&#8599;</span></div>
            <h3>Market & calculators</h3><p>Explore published meat prices and calculate feed mixes and costs.</p><span class="tool-link">Open market tools <span>&#8594;</span></span>
        </a>
        <a class="dashboard-tool weather-tool" asp-controller="Conditions" asp-action="Index">
            <div class="tool-top"><span class="tool-icon">&#9728;&#65039;</span><span class="tool-arrow">&#8599;</span></div>
            <h3>Weather & fire</h3><p>See the 7-day forecast, rainfall outlook, and weather-based fire caution.</p><span class="tool-link">View conditions <span>&#8594;</span></span>
        </a>
    </div>
</section>

<section class="dashboard-section" aria-labelledby="agri-news-heading">
    <div class="section-heading"><div><span class="dashboard-kicker">WHAT IS HAPPENING</span><h2 id="agri-news-heading">Agriculture news</h2><p class="text-muted mb-0">Latest headlines and what they could mean for the industry.</p></div><a class="btn btn-outline-primary" asp-controller="News" asp-action="Index">View all news </a></div>
    <div class="row g-3" id="dashboardNews" aria-live="polite"><div class="col-12"><p class="text-muted">Loading latest agriculture news</p></div></div>
</section>

<section class="dashboard-note">
    <div class="note-icon">&#10024;</div><div><h2>Practical information, all together</h2><p>Use the tools above to keep records current and make day-to-day farm decisions with the information available.</p></div>
</section>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('farmPasskeyPrompt');
    const register = document.getElementById('farmPasskeyRegister');
    const skip = document.getElementById('farmPasskeySkip');
    const status = document.getElementById('farmPasskeyStatus');
    const token = document.querySelector('#farmPasskeyAntiForgery input[name="__RequestVerificationToken"]')?.value;

    if (modal && register && skip && status) {
        if (!window.PublicKeyCredential || !navigator.credentials) {
            modal.remove();
        } else {
            register.addEventListener('click', async () => {
                register.disabled = true;
                skip.style.pointerEvents = 'none';
                status.textContent = 'Waiting for fingerprint…';
                try {
                    const optionsResponse = await fetch('/Account/PasskeyCreationOptions', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token }
                    });
                    if (!optionsResponse.ok) throw new Error(await optionsResponse.text());
                    const options = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
                    const credential = await navigator.credentials.create({ publicKey: options });
                    if (!credential) throw new Error('No passkey was created.');

                    const registrationResponse = await fetch('/Account/PasskeyRegistration', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ credentialJson: JSON.stringify(credential) })
                    });
                    if (!registrationResponse.ok) throw new Error(await registrationResponse.text());

                    status.textContent = 'Fingerprint login is ready.';
                    setTimeout(() => window.location.href = '/', 600);
                } catch (error) {
                    console.error(error);
                    status.textContent = error?.message || 'Fingerprint setup was cancelled or failed.';
                    register.disabled = false;
                    skip.style.pointerEvents = '';
                }
            });
        }
    }
});
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const enable = document.getElementById('enablePushButton');
    const test = document.getElementById('testPushButton');
    const status = document.getElementById('pushStatus');
    if (!enable || !test || !status) return;

    const token = () => document.querySelector('#pushAntiforgeryForm input[name="__RequestVerificationToken"]')?.value || '';
    const isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;

    const setReady = () => {
        enable.hidden = true;
        test.hidden = false;
        status.textContent = 'Notifications are enabled on this device. Send a test to confirm delivery.';
    };

    const base64ToBytes = value => {
        const padding = '='.repeat((4 - value.length % 4) % 4);
        const base64 = (value + padding).replace(/-/g, '+').replace(/_/g, '/');
        const raw = atob(base64);
        return Uint8Array.from([...raw].map(char => char.charCodeAt(0)));
    };

    const postJson = async (url, body) => {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify(body)
        });
        if (!response.ok) throw new Error((await response.json().catch(() => ({}))).error || 'Request failed.');
        return response.json();
    };

    enable.addEventListener('click', async () => {
        enable.disabled = true;
        try {
            if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) {
                throw new Error('Push notifications are not supported by this browser.');
            }
            if (isIos && !isStandalone) {
                throw new Error('On iPhone or iPad, add Farm to your Home Screen first, then enable notifications there.');
            }
            let permission = Notification.permission;
            if (permission !== 'granted') permission = await Notification.requestPermission();
            if (permission !== 'granted') throw new Error('Notification permission was not granted.');

            const registration = await navigator.serviceWorker.ready;
            const keyResponse = await fetch('/Push/PublicKey', { cache: 'no-store' });
            if (!keyResponse.ok) throw new Error('Could not load notification settings.');
            const { publicKey } = await keyResponse.json();
            let subscription = await registration.pushManager.getSubscription();
            if (!subscription) {
                subscription = await registration.pushManager.subscribe({
                    userVisibleOnly: true,
                    applicationServerKey: base64ToBytes(publicKey)
                });
            }

            const json = subscription.toJSON();
            let latitude = null, longitude = null;
            if ('geolocation' in navigator) {
                try {
                    const position = await new Promise((resolve, reject) =>
                        navigator.geolocation.getCurrentPosition(resolve, reject, { enableHighAccuracy: false, timeout: 8000, maximumAge: 3600000 }));
                    latitude = position.coords.latitude;
                    longitude = position.coords.longitude;
                } catch { /* Location is optional; notifications still work without fire alerts. */ }
            }
            await postJson('/Push/Subscribe', {
                endpoint: json.endpoint,
                p256dh: json.keys?.p256dh,
                auth: json.keys?.auth,
                latitude,
                longitude
            });
            setReady();
        } catch (error) {
            status.textContent = error.message || 'Could not enable notifications.';
            enable.disabled = false;
        }
    });

    test.addEventListener('click', async () => {
        test.disabled = true;
        status.textContent = 'Sending test notification...';
        try {
            await postJson('/Push/Test', {});
            status.textContent = 'Test sent. Check your notification tray.';
        } catch (error) {
            status.textContent = error.message || 'The test notification could not be sent.';
        } finally {
            test.disabled = false;
        }
    });

    if (window.Notification?.permission === 'granted') setReady();
});
</script>
<script>
document.addEventListener('DOMContentLoaded', async () => {
    const container = document.getElementById('dashboardNews');
    try {
        const response = await fetch('/News/Feed', { cache: 'no-store' });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'News is unavailable.');
        container.replaceChildren();
        for (const article of (data.articles || []).slice(0, 3)) {
            const col = document.createElement('div'); col.className = 'col-12 col-lg-4';
            const card = document.createElement('article'); card.className = 'news-card';
            const meta = document.createElement('div'); meta.className = 'news-card-meta';
            meta.textContent = `${article.source || 'Agriculture news'}  ${article.publishedAt ? new Date(article.publishedAt).toLocaleDateString() : 'Date unavailable'}`;
            const heading = document.createElement('h3'); heading.className = 'h5 news-card-title';
            const link = document.createElement('a'); link.className = 'news-card-title-link'; link.href = article.url; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.textContent = article.title; heading.appendChild(link);
            const summary = document.createElement('p'); summary.className = 'news-card-summary'; summary.textContent = article.summary || 'Open the story for details.';
            const impact = document.createElement('div'); impact.className = 'news-card-impact';
            const label = document.createElement('strong'); label.textContent = 'Potential industry impact: '; impact.append(label, document.createTextNode(article.impact || 'Impact not assessed.'));
            card.append(meta, heading, summary, impact); col.appendChild(card); container.appendChild(col);
        }
        if (!container.children.length) container.textContent = 'No agriculture stories available right now.';
    } catch (error) { container.textContent = 'Agriculture news is temporarily unavailable. Open the news page to try again.'; }
});
</script>
}



