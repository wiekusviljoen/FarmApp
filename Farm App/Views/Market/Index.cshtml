@{
    ViewData["Title"] = "Market & Cost Calculators";
}
<h1>Market prices & cost calculators</h1>
<p class="text-muted">Feedmaster prices are grouped as <strong>Sheep</strong> (Mutton), <strong>Beef</strong>, <strong>Wild</strong> (Game), and <strong>Auctions</strong>. Feed product choices are based on Feedmaster's catalog. Bag prices are editable because Feedmaster does not publish online bag prices.</p>
<section class="card p-4 mb-4">
 <div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><h2>Latest published meat prices</h2><button class="btn btn-outline-primary" onclick="loadLivePrices()">Refresh prices</button></div>
<p class="small text-muted" id="liveStatus">Loading live prices...</p>
 <div id="livePriceBlocks" class="mt-3"><p class="text-muted">Loading price categories...</p></div>
 <h3 class="mt-3">Published price trends</h3><p class="small text-muted">Historical entries available on Feedmaster's page. This is not a saved daily price history. Auction prices remain in their own category and are excluded from the meat-price trend chart.</p><canvas id="marketChart" height="150" style="width:100%"></canvas>
 <a href="https://www.feedmaster.com.na/meat-prices" target="_blank" rel="noopener">Source: Feedmaster meat prices</a>
</section>
<div class="row g-4">
 <div class="col-lg-6"><div class="card p-4 h-100">
<h2>Abattoir price comparison</h2>
  <p>Compare quoted prices per kg and estimate gross value.</p>
  <div class="mb-3"><label class="form-label">Abattoir / buyer</label><input id="buyer" class="form-control" placeholder="Buyer name" /></div>
  <div class="mb-3"><label class="form-label">Price per kg (NAD)</label><input id="abPrice" type="number" min="0" step="0.01" class="form-control" placeholder="e.g. 65.00" /></div>
  <div class="mb-3"><label class="form-label">Carcass weight (kg)</label><input id="carcass" type="number" min="0" step="0.1" class="form-control" value="20" /></div>
  <p class="fw-bold" id="payoutPreview">Estimated gross: NAD 0.00</p>
  <button class="btn btn-primary" onclick="addQuote()">Add quote to comparison</button>
  <h3 class="mt-4">Quote comparison</h3><div class="table-responsive"><table class="table" id="quotes"><thead><tr><th>Buyer</th><th>NAD/kg</th><th>Gross value</th></tr></thead><tbody></tbody></table></div>
  <p class="fw-bold" id="bestQuote">Enter a quote to compare.</p>
 </div></div>
 <div class="col-lg-6"><div class="card p-4 h-100">
  <h2>Animal feed cost calculator</h2>
  <p>Choose a Feedmaster product, keep its bag price up to date, and calculate mix costs.</p>
  <div class="mb-3"><div class="d-flex justify-content-between align-items-center gap-2"><label class="form-label" for="feedName">Feed product</label><button type="button" class="btn btn-sm btn-outline-secondary" onclick="refreshFeedProducts()">Refresh products</button></div><select id="feedName" class="form-select"><option value="">Loading product list...</option></select><small class="text-muted d-block mt-1" id="feedCatalogStatus">Feedmaster product catalog</small></div>
  <div class="row g-2 mb-3"><div class="col-sm-7"><label class="form-label">Current bag price (NAD)</label><input id="bagPrice" type="number" min="0" step="0.01" class="form-control" placeholder="Enter current supplier price" /></div><div class="col-sm-5"><label class="form-label">Bag size (kg)</label><input id="bagKg" type="number" min="1" step="1" class="form-control" value="50" /></div></div>
  <p class="small text-muted" id="feedPriceStatus">Enter the current supplier price; it will be saved for this product on this device.</p>
  <div class="mb-3"><label class="form-label">Amount used (kg)</label><input id="amountKg" type="number" min="0" step="0.1" class="form-control" placeholder="Kg in your mix" /></div>
  <p class="small fw-bold" id="ingredientPreview">Enter bag price and kg to preview ingredient cost.</p>
  <button class="btn btn-primary" onclick="addIngredient()">Add ingredient</button>
  <div class="table-responsive mt-4"><table class="table" id="ingredients"><thead><tr><th>Ingredient</th><th>Kg</th><th>Cost (NAD)</th></tr></thead><tbody></tbody></table></div>
  <p class="fw-bold" id="mixTotals">Mix total: NAD 0.00  |  Cost per kg: NAD 0.00</p>
  <button class="btn btn-outline-secondary" onclick="clearMix()">Clear mix</button>
  <hr class="my-4" />
  <h3>Feeding duration estimator</h3>
  <p>Estimate feed required and total cost for a selected product over a feeding period.</p>
  <div class="row g-3">
   <div class="col-6"><label class="form-label" for="animalCount">Number of animals</label><input id="animalCount" type="number" min="1" step="1" value="100" class="form-control" /></div>
   <div class="col-6"><label class="form-label" for="dailyFeed">Feed per animal per day (kg)</label><input id="dailyFeed" type="number" min="0.01" step="0.1" value="0.5" class="form-control" /></div>
   <div class="col-8"><label class="form-label" for="durationValue">Feeding duration</label><input id="durationValue" type="number" min="1" step="1" value="30" class="form-control" /></div>
   <div class="col-4"><label class="form-label" for="durationUnit">Unit</label><select id="durationUnit" class="form-select"><option value="1">Days</option><option value="7">Weeks</option><option value="30">Months (30 days)</option></select></div>
  </div>
  <div class="alert alert-light border mt-3 mb-0"><div id="feedingEstimate" class="fw-bold">Choose a product and enter its price to estimate feed cost.</div><small class="text-muted">This is a planning estimate based on your daily ration; confirm the correct ration for your animals.</small></div>
 </div></div>
</div>

@section Scripts {
<script>
const money = n => 'NAD ' + Number(n).toFixed(2);
async function loadLivePrices() {
 const status = document.getElementById('liveStatus');
 status.textContent = 'Fetching latest published prices from Feedmaster...';
 try {
  const response = await fetch('/Market/LiveMeat');
  const data = await response.json();
  if (!response.ok) throw new Error(data.error || 'Price source unavailable');
  // Keep the newest row for each category + grade/animal + published source.
  const latest = new Map();
  for (const item of data.prices) {
   const key = [item.category, item.item, item.sourceName].join('|');
   const old = latest.get(key);
   if (!old || item.date > old.date) latest.set(key, item);
  }
  const categoryOrder = { Sheep: 0, Beef: 1, Wild: 2, Auctions: 3 };
  const categoryInfo = {
   Sheep: { title: '🐑 Sheep / Mutton', note: 'Mutton prices. NC Average is highlighted first as the regional comparison.' },
   Beef: { title: '🐄 Beef', note: 'Beef prices, separate from sheep, wild game, and auctions.' },
   Wild: { title: '🦌 Wild / Game', note: 'Game meat prices in their own section.' },
   Auctions: { title: '🔨 Auctions', note: 'Auction prices are separate from abattoir meat prices.' }
  };
  const gradeOrder = grade => {
   const match = String(grade).trim().match(/^([A-Z]+)\s*(\d+)$/i);
   return match ? { prefix: match[1].toUpperCase(), number: Number(match[2]), valid: true } : { prefix: String(grade).trim().toUpperCase(), number: 0, valid: false };
  };
  const compareGrades = (a, b) => {
   const ga = gradeOrder(a), gb = gradeOrder(b);
   if (ga.valid && gb.valid) return ga.prefix.localeCompare(gb.prefix) || ga.number - gb.number;
   if (ga.valid !== gb.valid) return ga.valid ? -1 : 1;
   return String(a).localeCompare(String(b), undefined, { numeric: true, sensitivity: 'base' });
  };
  const items = [...latest.values()].sort((a,b) =>
   (categoryOrder[a.category] ?? 9) - (categoryOrder[b.category] ?? 9) ||
   (a.category === 'Sheep' ? compareGrades(a.item, b.item) : String(a.item).localeCompare(String(b.item), undefined, { numeric: true, sensitivity: 'base' })) ||
   (a.category === 'Sheep' ? (a.sourceName === 'NC Avg.' ? -1 : b.sourceName === 'NC Avg.' ? 1 : 0) : 0) ||
   a.sourceName.localeCompare(b.sourceName, undefined, { numeric: true, sensitivity: 'base' }));
  const blocks = Object.keys(categoryInfo).map(category => {
   const categoryItems = items.filter(x => x.category === category);
   if (!categoryItems.length) return '';
   const rows = categoryItems.map(x => {
    const label = x.category + ' · ' + x.item + ' · ' + x.sourceName;
    const action = x.category === 'Auctions' ? '<span class="text-muted">—</span>' : `<button class="btn btn-sm btn-outline-success" onclick="useLivePrice('${encodeURIComponent(label)}',${Number(x.price)})">Use price</button>`;
    const highlight = x.category === 'Sheep' && x.sourceName === 'NC Avg.' ? ' class="table-success fw-semibold"' : '';
    return `<tr${highlight}><td>${x.date}</td><td>${escapeHtml(x.item)}</td><td>${escapeHtml(x.sourceName)}</td><td>${money(x.price)}</td><td>${action}</td></tr>`;
   }).join('');
   return `<section class="card p-3 mb-3"><h3 class="h4">${categoryInfo[category].title}</h3><p class="small text-muted mb-2">${categoryInfo[category].note}</p><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Date</th><th>Grade / animal</th><th>Price source</th><th>Price (NAD, as published)</th><th>Action</th></tr></thead><tbody>${rows}</tbody></table></div></section>`;
  }).join('');
  document.getElementById('livePriceBlocks').innerHTML = blocks || '<p class="text-muted">No published price rows available.</p>';
  drawMarketChart(data.prices);
  status.textContent = `Updated ${new Date(data.fetchedAt).toLocaleString()}  |  Source values are published prices, not guaranteed buyer offers.`;
 } catch (error) { status.textContent = 'Live price update failed: ' + error.message; }
}
function drawMarketChart(rows) {
 const canvas=document.getElementById('marketChart'); if(!canvas)return;
 const ctx=canvas.getContext('2d'),w=canvas.clientWidth||700,h=260,dpr=window.devicePixelRatio||1;
 canvas.width=w*dpr;canvas.height=h*dpr;ctx.scale(dpr,dpr);
 const dates=[...new Set(rows.map(x=>x.date))].sort();
 const cats=['Sheep','Beef','Wild'];
 // Plot a category-level mean of non-zero published figures for each date.
 const series=cats.map(cat=>({cat,vals:dates.map(date=>{
  const values=rows.filter(x=>x.category===cat&&x.date===date&&Number.isFinite(Number(x.price))&&Number(x.price)>0).map(x=>Number(x.price));
  return values.length ? values.reduce((sum,v)=>sum+v,0)/values.length : null;
 })})).filter(s=>s.vals.filter(v=>v!==null).length>1);
 if(!dates.length||!series.length){ctx.font='14px sans-serif';ctx.fillText('Not enough dated price entries to show a trend.',10,30);return;}
 const vals=series.flatMap(s=>s.vals.filter(v=>v!==null)),min=Math.min(...vals),max=Math.max(...vals),span=Math.max(1,max-min),left=44,right=12,top=18,bottom=45,pw=w-left-right,ph=h-top-bottom;
 ctx.font='11px sans-serif';ctx.strokeStyle='#cbd5e1';ctx.fillStyle='#64748b';
 for(let i=0;i<=4;i++){const y=top+ph*i/4;ctx.beginPath();ctx.moveTo(left,y);ctx.lineTo(w-right,y);ctx.stroke();ctx.fillText((max-span*i/4).toFixed(1),2,y+4);}
 const colors=['#2878b5','#d97706','#15803d','#9333ea','#dc2626','#0891b2','#a16207'];
 series.forEach((s,j)=>{ctx.strokeStyle=colors[j%colors.length];ctx.lineWidth=2;ctx.beginPath();let started=false;s.vals.forEach((v,i)=>{if(v===null)return;const x=left+(dates.length===1?0:i*pw/(dates.length-1)),y=top+ph-(v-min)/span*ph;if(!started){ctx.moveTo(x,y);started=true;}else ctx.lineTo(x,y);});ctx.stroke();});
 dates.forEach((date,i)=>{if(dates.length>7&&i%Math.ceil(dates.length/7)!==0&&i!==dates.length-1)return;const x=left+(dates.length===1?0:i*pw/(dates.length-1));ctx.fillStyle='#64748b';ctx.fillText(date.slice(5),x-15,h-24);});
 let lx=left;ctx.font='11px sans-serif';series.slice(0,9).forEach((s,j)=>{ctx.fillStyle=colors[j%colors.length];ctx.fillRect(lx, h-13, 9, 9);ctx.fillText(s.cat,lx+12,h-5);lx+=Math.max(55,ctx.measureText(s.cat).width+28);if(lx>w-60)lx=left;});
}
function useLivePrice(encodedName, price) {
 const decodedName = decodeURIComponent(encodedName);
 if (decodedName.startsWith('Auctions  | ')) { alert('Auction prices are shown separately and may not be per-kg abattoir quotes.'); return; }
 document.getElementById('buyer').value = 'Feedmaster - ' + decodedName;
 document.getElementById('abPrice').value = Number(price).toFixed(2);
 document.getElementById('abPrice').focus();
}
const quotes = [];
function addQuote() {
 const buyer = document.getElementById('buyer').value.trim();
 const price = Number(document.getElementById('abPrice').value);
 const kg = Number(document.getElementById('carcass').value);
 if (!buyer || price <= 0 || kg <= 0) { alert('Enter buyer, price, and carcass weight.'); return; }
 quotes.push({buyer, price, value: price * kg});
 quotes.sort((a,b) => b.price-a.price);
 document.querySelector('#quotes tbody').innerHTML = quotes.map(q => `<tr><td>${escapeHtml(q.buyer)}</td><td>${money(q.price)}</td><td>${money(q.value)}</td></tr>`).join('');
 document.getElementById('bestQuote').textContent = `Highest entered price: ${quotes[0].buyer} at ${money(quotes[0].price)}/kg`;
}
const feedProducts = [
 {name:'Feedlot 80',group:'Beef cattle',bagKg:50},{name:'Bush Improver Lick',group:'Beef cattle / sheep',bagKg:50},
 {name:'Cattle Lick 40',group:'Beef cattle',bagKg:50},{name:'Eco-Grassveld Lick',group:'General livestock',bagKg:50},
 {name:'Cattle Mix 4:1:5',group:'Beef cattle',bagKg:50},{name:'Beefpro 14 Pellets',group:'Beef cattle',bagKg:50},
 {name:'Rangeland Grower Meal',group:'Cattle / sheep / goats',bagKg:50},{name:'Feed Concentrate HPC 30',group:'Cattle / sheep / goats',bagKg:50},
 {name:'Breker 12',group:'Cattle / sheep / goats',bagKg:50},{name:'Enerfeed',group:'Cattle / sheep / goats',bagKg:50},
 {name:'Enermol',group:'Cattle / sheep / goats',bagKg:50},{name:'Yellow Maize Meal No.1',group:'Cattle / sheep / goats',bagKg:50},
 {name:'Yellow Maize Meal No.2',group:'Cattle / sheep / goats',bagKg:50},{name:'Lucerne Pellets',group:'Cattle / sheep / game',bagKg:50},
 {name:'Dry Veld Concentrate',group:'Cattle / sheep / goats',bagKg:50},{name:'Complete Sheep Finisher',group:'Sheep',bagKg:50},
 {name:'Ram-Lam-Ewe Pellets',group:'Sheep',bagKg:50},{name:'Production Lick',group:'Sheep / goats',bagKg:40},
 {name:'Super Lambing Lick',group:'Sheep / goats',bagKg:50},{name:'Creep Feed',group:'Sheep / goats',bagKg:50},
 {name:'Stud Feed',group:'Sheep / goats',bagKg:50},{name:'Game Lick',group:'Game',bagKg:50},
 {name:'Standard Game Pellets',group:'Game',bagKg:50},{name:'Stud Game Pellets',group:'Game',bagKg:50},
 {name:'Game Block',group:'Game / horses',bagKg:20},{name:'Futterfos P6',group:'Minerals',bagKg:50},
 {name:'Futterfos Block',group:'Minerals',bagKg:20},{name:'Futterfos',group:'Minerals',bagKg:40},
 {name:'Veefos P12',group:'Minerals',bagKg:50},{name:'Dryveld Block',group:'Minerals',bagKg:20},
 {name:'Energy Block',group:'Minerals',bagKg:20},{name:'Cow Calf Lick',group:'Beef cattle',bagKg:50},
 {name:'Calf Starter',group:'Dairy / calves',bagKg:50},{name:'Calf Grower',group:'Dairy / calves',bagKg:50},
 {name:'Layer Mash',group:'Poultry',bagKg:50},{name:'Broiler Starter',group:'Poultry',bagKg:50},
 {name:'Broiler Grower',group:'Poultry',bagKg:50},{name:'Enerfeed (pig feed)',group:'Pigs',bagKg:50},
 {name:'Enermol (pig feed)',group:'Pigs',bagKg:50}
];
const feedPriceStoreKey = 'farmflow.feedPrices.v1';
function readFeedPrices() { try { return JSON.parse(localStorage.getItem(feedPriceStoreKey) || '{}'); } catch { return {}; } }
let feedPrices = readFeedPrices();
function selectedProduct() { return feedProducts.find(p => p.name === document.getElementById('feedName').value); }
function renderFeedProductOptions(keepName = '') {
 const select = document.getElementById('feedName');
 const groups = [...new Set(feedProducts.map(p => p.group))];
 select.innerHTML = '<option value="">Choose a feed product...</option>' + groups.map(group =>
  '<optgroup label="' + escapeHtml(group) + '">' + feedProducts.filter(p => p.group === group).map(p =>
   '<option value="' + escapeHtml(p.name) + '">' + escapeHtml(p.name) + ' (' + p.bagKg + ' kg)</option>').join('') + '</optgroup>').join('');
 if (keepName && feedProducts.some(p => p.name === keepName)) select.value = keepName;
}
function initFeedProducts() {
 const select = document.getElementById('feedName');
 select.addEventListener('change', loadSelectedProduct);
 renderFeedProductOptions();
 loadSelectedProduct();
}
async function refreshFeedProducts() {
 const status = document.getElementById('feedCatalogStatus');
 const keepName = document.getElementById('feedName').value;
 status.textContent = 'Refreshing product catalog from Feedmaster...';
 try {
  const response = await fetch('/Market/FeedProducts');
  const data = await response.json();
  if (!response.ok) throw new Error(data.error || 'Catalog unavailable');
  const refreshed = data.products.map(p => {
   const group = p.group || 'Feedmaster products';
   return {name:p.name, group, bagKg:Number(p.bagKg)||50};
  });
  if (!refreshed.length) throw new Error('No products were returned.');
  feedProducts.splice(0, feedProducts.length, ...refreshed);
  renderFeedProductOptions(keepName);
  loadSelectedProduct();
  status.textContent = 'Catalog refreshed ' + new Date(data.fetchedAt).toLocaleString() + '  |  ' + refreshed.length + ' products.';
 } catch (error) {
  status.textContent = 'Could not refresh catalog: ' + error.message + '  |  Showing available saved choices.';
 }
}
function loadSelectedProduct() {
 const product = selectedProduct();
 const priceInput = document.getElementById('bagPrice');
 const saved = product && feedPrices[product.name];
 document.getElementById('bagKg').value = saved ? saved.bagKg : (product ? product.bagKg : 50);
 priceInput.value = saved ? saved.price : '';
 document.getElementById('feedPriceStatus').textContent = saved
  ? 'Saved price: ' + money(saved.price) + ' per ' + saved.bagKg + ' kg bag  |  Updated ' + new Date(saved.updatedAt).toLocaleString() + ' (stored on this device).'
  : 'No saved price for this product. Enter the latest supplier price; it will be saved on this device.';
 updatePreviews();
}
function saveSelectedFeedPrice() {
 const product = selectedProduct(), value = Number(document.getElementById('bagPrice').value);
 const bagKg = Number(document.getElementById('bagKg').value);
 if (!product || document.getElementById('bagPrice').value === '' || !Number.isFinite(value) || value <= 0 || !Number.isFinite(bagKg) || bagKg <= 0) return;
 feedPrices[product.name] = {price:value, updatedAt:new Date().toISOString(), bagKg};
 localStorage.setItem(feedPriceStoreKey, JSON.stringify(feedPrices));
 document.getElementById('feedPriceStatus').textContent = 'Price saved: ' + money(value) + ' per ' + bagKg + ' kg bag  |  Updated just now (this device only).';
 updatePreviews();
}
const ingredients = [];
function addIngredient() {
 const product = selectedProduct();
 const name = product ? product.name : '';
 const price = Number(document.getElementById('bagPrice').value);
 const bagKg = Number(document.getElementById('bagKg').value) || 50;
 const kg = Number(document.getElementById('amountKg').value);
 if (!name || price <= 0 || !Number.isFinite(price) || kg <= 0) { alert('Choose a product and enter its current bag price and kg used.'); return; }
 ingredients.push({name, kg, cost: price / bagKg * kg}); renderMix();
}
function renderMix() {
 const total = ingredients.reduce((s,x) => s+x.cost,0), kg = ingredients.reduce((s,x) => s+x.kg,0);
 document.querySelector('#ingredients tbody').innerHTML = ingredients.map(x => `<tr><td>${escapeHtml(x.name)}</td><td>${x.kg.toFixed(1)}</td><td>${money(x.cost)}</td></tr>`).join('');
 document.getElementById('mixTotals').textContent = `Mix total: ${money(total)}  |  Total weight: ${kg.toFixed(1)} kg  |  Cost per kg: ${money(kg ? total/kg : 0)}`;
}
function clearMix() { ingredients.length=0; renderMix(); }
function updateFeedingEstimate() {
 const product=selectedProduct(), price=Number(document.getElementById('bagPrice').value), bagKg=Number(document.getElementById('bagKg').value)||50;
 const count=Number(document.getElementById('animalCount').value), ration=Number(document.getElementById('dailyFeed').value);
 const days=Number(document.getElementById('durationValue').value)*Number(document.getElementById('durationUnit').value);
 const target=document.getElementById('feedingEstimate');
 if(!product || price<=0 || count<=0 || ration<=0 || days<=0){target.textContent='Choose a product, enter its current bag price, and complete the feeding details.';return;}
 const totalKg=count*ration*days, bags=Math.ceil(totalKg/bagKg), totalCost=totalKg/bagKg*price, bagCost=bags*price;
 target.textContent=`${days.toLocaleString()} days  |  ${totalKg.toLocaleString(undefined,{maximumFractionDigits:1})} kg feed needed  |  ${bags.toLocaleString()} bags of ${bagKg} kg  |  Estimated cost by kg: ${money(totalCost)}  |  Cost if buying full bags: ${money(bagCost)}`;
}
function updatePreviews() {
 const price = Number(document.getElementById('abPrice').value) || 0;
 const weight = Number(document.getElementById('carcass').value) || 0;
 document.getElementById('payoutPreview').textContent = `Estimated gross: ${money(price * weight)}`;
 const bag = Number(document.getElementById('bagPrice').value) || 0;
 const bagKg = Number(document.getElementById('bagKg').value) || 50;
 const kg = Number(document.getElementById('amountKg').value) || 0;
 document.getElementById('ingredientPreview').textContent = bag > 0 && kg > 0 ? `Ingredient estimate: ${money(bag / bagKg * kg)} for ${kg.toFixed(1)} kg  |  ${money(bag / bagKg)} per kg` : 'Enter bag price and kg to preview ingredient cost.';
 updateFeedingEstimate();
}
['abPrice','carcass','bagPrice','amountKg','animalCount','dailyFeed','durationValue','durationUnit'].forEach(id => document.getElementById(id).addEventListener('input', updatePreviews));
document.getElementById('bagPrice').addEventListener('change', saveSelectedFeedPrice);
document.getElementById('bagKg').addEventListener('input', updatePreviews);
document.getElementById('bagKg').addEventListener('change', saveSelectedFeedPrice);
document.getElementById('durationUnit').addEventListener('change', updatePreviews);
document.addEventListener('DOMContentLoaded', () => { initFeedProducts(); updatePreviews(); loadLivePrices(); refreshFeedProducts(); });
function escapeHtml(s) { return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
</script>
}
