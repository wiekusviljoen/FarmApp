@model Farm_App.Models.FarmCamp
@{ ViewData["Title"] = "Update camp"; }
<h1>Update camp: @Model.Name</h1>
<p class="text-muted">Change the camp size or carrying-capacity rule.</p>
<form asp-action="Edit" method="post" class="row g-3">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Hectares" class="form-label"></label><input asp-for="Hectares" class="form-control" type="number" min="0.01" step="0.01" /></div>
    <div class="col-md-6"><label asp-for="CapacitySpecies" class="form-label"></label><select asp-for="CapacitySpecies" class="form-select"><option>Sheep</option><option>Goat</option><option>Cattle</option><option>Other</option></select></div>
    <div class="col-md-6"><label asp-for="CapacityMode" class="form-label"></label><select asp-for="CapacityMode" class="form-select"><option value="Calculated">Automatic calculation</option><option value="Manual">Manual capacity</option></select></div>
    <div class="col-md-6"><label asp-for="HectaresPerHead" class="form-label"></label><div class="input-group"><input asp-for="HectaresPerHead" class="form-control" type="number" min="0.01" step="0.01" /><span class="input-group-text">ha / head</span></div></div>
    <div class="col-md-6"><label asp-for="ManualCapacity" class="form-label"></label><input asp-for="ManualCapacity" class="form-control" type="number" min="0" step="1" /></div>
    <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
    <div class="col-12"><button class="btn btn-primary">Save changes</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form>