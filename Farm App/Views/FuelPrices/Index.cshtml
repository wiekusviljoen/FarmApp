@{
    ViewData["Title"] = "Namibia Fuel Prices";
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <p class="text-uppercase small text-muted mb-1">Namibia · Local fuel price</p>
        <h1>Fuel prices</h1>
        <p class="text-muted mb-0">Current regulated pump prices for <strong>Koës / ǁKaras</strong>.</p>
    </div>
    <span class="badge text-bg-success fs-6">Effective 7 October 2026</span>
</div>
<div class="alert alert-success" role="note">
    <strong>Koës price:</strong> These are the regulated Koës prices, including the published inland transport differential. Petrol 95 increased by N$1.50/litre from 7 October; diesel prices were held unchanged for October. <a href="https://informante.web.na/?p=401816" target="_blank" rel="noopener">Latest October fuel announcement</a>.
</div>
<div class="row g-3 mb-4">
    <div class="col-md-4"><section class="card p-4 h-100"><div class="small text-muted">Petrol 95 (ULP)</div><div class="display-6 fw-bold">N$27.62</div><div class="small text-muted">per litre · Koës</div></section></div>
    <div class="col-md-4"><section class="card p-4 h-100"><div class="small text-muted">Diesel 50ppm</div><div class="display-6 fw-bold">N$28.90</div><div class="small text-muted">per litre · Koës</div></section></div>
    <div class="col-md-4"><section class="card p-4 h-100"><div class="small text-muted">Diesel 10ppm</div><div class="display-6 fw-bold">N$29.00</div><div class="small text-muted">per litre · Koës</div></section></div>
</div>
<div class="card p-4 mb-4">
    <h2 class="h3">Fuel cost calculator</h2>
    <p class="text-muted">Estimate the cost of filling a tank or buying fuel for a trip. Change the price to match your local station.</p>
    <div class="row g-3">
        <div class="col-md-4"><label class="form-label" for="fuelType">Fuel type</label><select id="fuelType" class="form-select"><option value="27.62">Petrol 95 — N$27.62/L</option><option value="28.90" selected>Diesel 50ppm — N$28.90/L</option><option value="29.00">Diesel 10ppm — N$29.00/L</option></select></div>
        <div class="col-md-4"><label class="form-label" for="fuelPrice">Price per litre (N$)</label><input id="fuelPrice" class="form-control" type="number" min="0" step="0.01" value="28.90" /></div>
        <div class="col-md-4"><label class="form-label" for="fuelLitres">Litres</label><input id="fuelLitres" class="form-control" type="number" min="0" step="1" value="80" /></div>
    </div>
    <div class="mt-4 p-3 rounded bg-light"><span class="text-muted">Estimated total</span><div class="display-6 fw-bold" id="fuelTotal">N$2,312.00</div></div>
</div>
<div class="small text-muted">Last checked: 8 October 2026 · Koës regulated prices effective 7 October 2026. Source: Namibia Ministry of Industries, Mines and Energy pricing schedule and October fuel-price announcement.</div>
<p class="mt-2"><a href="https://informante.web.na/?p=401816" target="_blank" rel="noopener">Read the October fuel-price announcement</a></p>
@section Scripts {
<script>
(() => {
    const type = document.getElementById('fuelType');
    const price = document.getElementById('fuelPrice');
    const litres = document.getElementById('fuelLitres');
    const total = document.getElementById('fuelTotal');
    const money = value => 'N$' + value.toLocaleString('en-NA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const update = () => {
        const p = Math.max(0, Number(price.value) || 0);
        const l = Math.max(0, Number(litres.value) || 0);
        total.textContent = money(p * l);
    };
    type.addEventListener('change', () => { price.value = type.value; update(); });
    price.addEventListener('input', update);
    litres.addEventListener('input', update);
    update();
})();
</script>
}
