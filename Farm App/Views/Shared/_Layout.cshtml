@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var isAuthPage = currentPath.StartsWith("/Identity/Account/Login", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/Identity/Account/Register", StringComparison.OrdinalIgnoreCase);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var offlineUserId = isAuthenticated ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Farm</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css?v=20260928" />
    <link rel="stylesheet" href="~/css/site.css?v=20260930-nav2" />
    <link rel="manifest" href="~/manifest.webmanifest?v=20261001-farm-logo" />
    <link rel="icon" type="image/svg+xml" href="~/farm-logo.svg?v=20261001-farm-logo" />
    <link rel="apple-touch-icon" href="~/farm-logo.svg?v=20261001-farm-logo" />
</head>
<body class="@(isAuthPage ? "auth-page" : string.Empty)">
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-sm farm-navbar border-bottom shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand brand-mark" asp-area="" asp-controller="Home" asp-action="Index">
                    <img class="brand-icon" src="~/farm-logo.svg?v=20261001-farm-logo" alt="" />
                    Farm
                </a>
                <div class="farm-header-status" aria-live="polite"><span class="farm-header-status-dot" aria-hidden="true"></span><span id="offlineStatus">Online</span></div>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Livestock" asp-action="Index">Livestock</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="AnimalHealth" asp-action="Index">Animal Health</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Market" asp-action="Index">Market & Calculators</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="FuelPrices" asp-action="Index">Fuel Prices</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Conditions" asp-action="Index">Weather & Fire</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Auctions" asp-action="Index">Auction Calendar</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="News" asp-action="Index">Agriculture News</a></li>
                        <li class="nav-item nav-privacy"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    </ul>
                    <div class="farm-location-control my-2 my-lg-0 me-lg-3">
                        <label for="farmLocationMode" class="small mb-1">Location</label>
                        <select id="farmLocationMode" class="form-select form-select-sm" aria-label="Location mode">
                            <option value="auto">Auto (GPS)</option><option value="manual">Manual region</option>
                        </select>
                        <select id="farmRegion" class="form-select form-select-sm mt-1" aria-label="Choose region" style="display:none">
                            <option value="Koes">Koes / ǁKaras</option><option value="Karas">ǁKaras</option><option value="Hardap">Hardap</option><option value="Khomas">Khomas</option><option value="Erongo">Erongo</option><option value="Kunene">Kunene</option><option value="Oshana">Oshana</option><option value="Omusati">Omusati</option><option value="Ohangwena">Ohangwena</option><option value="Oshikoto">Oshikoto</option><option value="Kavango East">Kavango East</option><option value="Kavango West">Kavango West</option><option value="Zambezi">Zambezi</option><option value="Otjozondjupa">Otjozondjupa</option>
                        </select>
                    </div>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3 page-shell">
            @RenderBody()
        </main>
    </div>
    <button type="button" id="floatingBackButton" class="floating-back-button" aria-label="Go back" title="Go back" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }">
        Back
    </button>
    <button type="button" id="floatingTopButton" class="floating-back-button floating-top-button" aria-label="Scroll to top" title="Scroll to top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' });">
        Top
    </button>
    <footer class="border-top footer text-muted">
        <div class="container">&copy; 2026 - Farm - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>window.farmFlowUserId = @(isAuthenticated && offlineUserId is not null ? System.Text.Json.JsonSerializer.Serialize(offlineUserId) : "null"); if (!window.farmFlowUserId) localStorage.removeItem("farmflow.user"); else localStorage.setItem("farmflow.user", window.farmFlowUserId);</script>
    <script src="~/js/offline.js" asp-append-version="true"></script>
    <script>if ("serviceWorker" in navigator) navigator.serviceWorker.register("/service-worker.js", { updateViaCache: "none" }).catch(() => {});</script>
    <script>
    (() => {
        const mode = document.getElementById('farmLocationMode');
        const region = document.getElementById('farmRegion');
        if (!mode || !region) return;
        const savedMode = localStorage.getItem('farmLocationMode') || 'auto';
        const savedRegion = localStorage.getItem('farmRegion') || 'Koes';
        mode.value = savedMode; region.value = savedRegion;
        region.style.display = savedMode === 'manual' ? '' : 'none';
        const changed = () => {
            localStorage.setItem('farmLocationMode', mode.value);
            localStorage.setItem('farmRegion', region.value);
            region.style.display = mode.value === 'manual' ? '' : 'none';
            window.dispatchEvent(new CustomEvent('farm-location-changed', { detail: { mode: mode.value, region: region.value } }));
        };
        mode.addEventListener('change', changed); region.addEventListener('change', changed);
    })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
    (() => {
        const cleanInjectedDebugText = () => {
            const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
            const nodes = [];
            let node;
            while (node = walker.nextNode()) nodes.push(node);
            nodes.forEach(n => {
                const t = n.nodeValue || '';
                if (t.includes('[Reading ') || t.includes('[executed on device:')) n.remove();
            });
        };
        cleanInjectedDebugText();
        new MutationObserver(cleanInjectedDebugText).observe(document.body, {childList:true, subtree:true});
    })();
    </script>
</body>
</html>
